//@version=5
indicator(title = "SMC & ICT & Indicators + Scalping Master"
  , overlay = true
  , max_labels_count = 500
  , max_lines_count = 500
  , max_boxes_count = 500
  , max_bars_back = 1000
  , behind_chart = false)
//-----------------------------------------------------------------------------{
//Constants
//-----------------------------------------------------------------------------{
color TRANSP_CSS = #ffffff00

// Number text is independent of zone colors; dark text contrasts with the bright label fills.
color priceNumberColor = #111827

//Tooltips
string MODE_TOOLTIP          = 'Allows to display historical Structure or only the recent ones'
string STYLE_TOOLTIP         = 'Indicator color theme'
string COLOR_CANDLES_TOOLTIP = 'Paint whole candles (body, border and wick) with the internal structure trend: the Bullish Structure color while it is bullish, the Bearish Structure color while it is bearish (light/dark gray in Monochrome style). Filled = the candle closed with the trend, hollow = a pullback candle.\n\nThe indicator has to sit in front of the chart candles (indicator ⋯ menu → Visual Order → Bring to Front). Sent behind them, only the candle bodies are colored'
string SHOW_INTERNAL         = 'Display internal market structure'
string CONFLUENCE_FILTER     = 'Filter non significant internal structure breakouts\n\nA bullish break only counts when the breakout candle closes in the upper half of its range (a bearish break: lower half), so rejection-wick fakeouts are ignored. A later candle that closes beyond the level with a valid close still confirms the break'
string INTERNAL_LEN          = 'Number of bars used to confirm internal (minor) swing points. The effective internal length is capped below Swing Length so internal structure stays the smaller structure'
string SHOW_SWING            = 'Display swing market Structure'
string SHOW_SWING_POINTS     = 'Display swing point as labels on the chart'
string SHOW_SWHL_POINTS      = 'Highlight most recent strong and weak high/low points on the chart'
string INTERNAL_OB           = 'Display internal order blocks on the chart\n\nNumber of internal order blocks to display: the ones nearest to price'
string SWING_OB              = 'Display swing order blocks on the chart\n\nNumber of swing order blocks to display: the ones nearest to price'
string FILTER_OB             = 'Method used to filter out volatile order blocks \n\nIt is recommended to use the cumulative mean range method when a low amount of data is available'
string OB_CANDLE             = 'Opposite Candle (ICT): bullish OB = last down-close candle before the bullish displacement that broke structure, bearish OB = last up-close candle before the bearish displacement. If the leg has no such candle, or that candle is a volatile outlier (Order Block Filter) or was closed through before the break, no OB is drawn\n\nExtreme Candle (LuxAlgo): the candle with the lowest low / highest high of the leg, whatever its color'
string OB_DISP               = 'ICT mode. A displacement candle needs a body of at least this many ATR(14) in the direction of the break'
string SHOW_EQHL             = 'Display equal highs and equal lows on the chart'
string EQHL_BARS             = 'Number of bars used to confirm equal highs and equal lows'
string EQHL_THRESHOLD        = 'Sensitivity threshold in a range (0, 1) used for the detection of equal highs & lows\n\nLower values will return fewer but more pertinent results'
string SHOW_FVG              = 'Display fair values gaps on the chart'
string AUTO_FVG              = 'Filter out non significant fair value gaps'
string FVG_TF                = 'Fair value gaps timeframe. Must be the chart timeframe or higher; a lower timeframe falls back to the chart timeframe (a label on the chart says so)'
string EXTEND_FVG            = 'Determine how many bars to extend the Fair Value Gap boxes past the current bar'
string PED_ZONES             = 'Display premium, discount, and equilibrium zones on chart'

//-----------------------------------------------------------------------------{
//Settings
//-----------------------------------------------------------------------------{
//General
//----------------------------------------{
mode = input.string('Historical'
  , options = ['Historical', 'Present']
  , group = 'Smart Money Concepts'
  , tooltip = MODE_TOOLTIP)

style = input.string('Colored'
  , options = ['Colored', 'Monochrome']
  , group = 'Smart Money Concepts'
  , tooltip = STYLE_TOOLTIP)

show_trend = input(true, 'Color Candles'
  , group = 'Smart Money Concepts'
  , tooltip = COLOR_CANDLES_TOOLTIP)

aoi_max_dist = input.float(0.2, 'Hide Zones Farther Than (× Recent Range)'
  , minval = 0
  , step = 0.05
  , group = 'Smart Money Concepts'
  , tooltip = 'Recent range = highest high to lowest low of the last 120 chart bars (about one screen).\n\nOrder blocks, fair value gaps, previous day/week/month levels, key level zones and demand/supply lines lying more than this share of the recent range above its high or below its low are not drawn (they are still tracked and reappear when price gets closer), so far-away objects never squash the candles.\n\nThe range is measured on the chart itself, so one value fits every timeframe and follows the current volatility.\n\n0.2 is a display padding choice, not a predicted price boundary. Zones reappear when their price range intersects the recent range plus padding. Market price can travel beyond this range.\n\n0 = draw everything')

//----------------------------------------}
//Internal Structure
//----------------------------------------{
show_internals = input(true, 'Show Internal Structure'
  , group = 'Real Time Internal Structure'
  , tooltip = SHOW_INTERNAL)

show_ibull = input.string('All', 'Bullish Structure'
  , options = ['All', 'BOS', 'CHoCH']
  , inline = 'ibull'
  , group = 'Real Time Internal Structure')

swing_ibull_css = input(#00c8ff, ''
  , inline = 'ibull'
  , group = 'Real Time Internal Structure')

//Bear Structure
show_ibear = input.string('All', 'Bearish Structure'
  , options = ['All', 'BOS', 'CHoCH']
  , inline = 'ibear'
  , group = 'Real Time Internal Structure')

swing_ibear_css = input(#ffc800, ''
  , inline = 'ibear'
  , group = 'Real Time Internal Structure')

ilength = input.int(5, 'Internal Length'
  , minval = 2
  , maxval = 250
  , group = 'Real Time Internal Structure'
  , tooltip = INTERNAL_LEN)

ifilter_confluence = input(true, 'Confluence Filter'
  , group = 'Real Time Internal Structure'
  , tooltip = CONFLUENCE_FILTER)

//----------------------------------------}
//Swing Structure
//----------------------------------------{
show_Structure = input(true, 'Show Swing Structure'
  , group = 'Real Time Swing Structure'
  , tooltip = SHOW_SWING)

//Bull Structure
show_bull = input.string('All', 'Bullish Structure'
  , options = ['All', 'BOS', 'CHoCH']
  , inline = 'bull'
  , group = 'Real Time Swing Structure')

swing_bull_css = input(#00c8ff, ''
  , inline = 'bull'
  , group = 'Real Time Swing Structure')

//Bear Structure
show_bear = input.string('All', 'Bearish Structure'
  , options = ['All', 'BOS', 'CHoCH']
  , inline = 'bear'
  , group = 'Real Time Swing Structure')

swing_bear_css = input(#ffc800, ''
  , inline = 'bear'
  , group = 'Real Time Swing Structure')

//Swings
show_swings = input(true, 'Show Swings Points'
  , inline = 'swings'
  , group = 'Real Time Swing Structure'
  , tooltip = SHOW_SWING_POINTS)

length = input.int(25, ''
  , minval = 10
  , maxval = 250
  , inline = 'swings'
  , group = 'Real Time Swing Structure')

show_hl_swings = input(true, 'Show Strong/Weak High/Low'
  , group = 'Real Time Swing Structure'
  , tooltip = SHOW_SWHL_POINTS)

//----------------------------------------}
//Order Blocks
//----------------------------------------{
show_iob = input(true, 'Internal Order Blocks'
  , inline = 'iob'
  , group = 'Order Blocks'
  , tooltip = INTERNAL_OB)

iob_showlast = input.int(3, ''
  , minval = 1
  , maxval = 20
  , inline = 'iob'
  , group = 'Order Blocks')

show_ob = input(true, 'Swing Order Blocks'
  , inline = 'ob'
  , group = 'Order Blocks'
  , tooltip = SWING_OB)

ob_showlast = input.int(3, ''
  , minval = 1
  , maxval = 20
  , inline = 'ob'
  , group = 'Order Blocks')

ob_filter = input.string('Atr', 'Order Block Filter'
  , options = ['Atr', 'Cumulative Mean Range']
  , group = 'Order Blocks'
  , tooltip = FILTER_OB)

ob_candle = input.string('Opposite Candle (ICT)', 'Order Block Candle'
  , options = ['Opposite Candle (ICT)', 'Extreme Candle (LuxAlgo)']
  , group = 'Order Blocks'
  , tooltip = OB_CANDLE)

ob_disp_mult = input.float(1.0, 'Displacement Body (× ATR)'
  , minval = 0
  , step = 0.1
  , group = 'Order Blocks'
  , tooltip = OB_DISP)

ibull_ob_css = input.color(color.new(#3179f5, 80), 'Internal Bullish OB'
  , group = 'Order Blocks')

ibear_ob_css = input.color(color.new(#f77c80, 80), 'Internal Bearish OB'
  , group = 'Order Blocks')

bull_ob_css = input.color(color.new(#1848cc, 80), 'Bullish OB'
  , group = 'Order Blocks')

bear_ob_css = input.color(color.new(#b22833, 80), 'Bearish OB'
  , group = 'Order Blocks')

//----------------------------------------}
//EQH/EQL
//----------------------------------------{
show_eq = input(true, 'Equal High/Low'
  , group = 'EQH/EQL'
  , tooltip = SHOW_EQHL)

eq_len = input.int(5, 'Bars Confirmation'
  , minval = 1
  , maxval = 100
  , group = 'EQH/EQL'
  , tooltip = EQHL_BARS)

eq_threshold = input.float(0.1, 'Threshold'
  , minval = 0
  , maxval = 0.5
  , step = 0.1
  , group = 'EQH/EQL'
  , tooltip = EQHL_THRESHOLD)

//----------------------------------------}
//Fair Value Gaps
//----------------------------------------{
show_fvg = input(true, 'Fair Value Gaps'
  , group = 'Fair Value Gaps'
  , tooltip = SHOW_FVG)

fvg_auto = input(true, "Auto Threshold"
  , group = 'Fair Value Gaps'
  , tooltip = AUTO_FVG)

fvg_tf = input.timeframe('', "Timeframe"
  , group = 'Fair Value Gaps'
  , tooltip = FVG_TF)

bull_fvg_css = input.color(color.new(#00ff68, 70), 'Bullish FVG'
  , group = 'Fair Value Gaps')

bear_fvg_css = input.color(color.new(#ff0008, 70), 'Bearish FVG'
  , group = 'Fair Value Gaps')

fvg_extend = input.int(5, "Extend FVG"
  , minval = 0
  , maxval = 500
  , group = 'Fair Value Gaps'
  , tooltip = EXTEND_FVG)

fvg_extend_active = input(true, "Extend Until Filled"
  , group = 'Fair Value Gaps'
  , tooltip = 'Keep unfilled gaps extended to the current bar (plus the Extend FVG bars). A gap is deleted once price fills it completely')

fvg_max_active = input.int(5, "Max Active FVGs (per side)"
  , minval = 1
  , maxval = 15
  , group = 'Fair Value Gaps'
  , tooltip = 'Oldest unfilled gaps beyond this count are removed')

//----------------------------------------}
//Previous day/week high/low
//----------------------------------------{
//Daily
show_pdhl = input(true, 'Daily'
  , inline = 'daily'
  , group = 'Highs & Lows MTF')

pdhl_style = input.string('⎯⎯⎯', ''
  , options = ['⎯⎯⎯', '----', '····']
  , inline = 'daily'
  , group = 'Highs & Lows MTF')

pdhl_css = input(#2157f3, ''
  , inline = 'daily'
  , group = 'Highs & Lows MTF')

//Weekly
show_pwhl = input(true, 'Weekly'
  , inline = 'weekly'
  , group = 'Highs & Lows MTF')

pwhl_style = input.string('----', ''
  , options = ['⎯⎯⎯', '----', '····']
  , inline = 'weekly'
  , group = 'Highs & Lows MTF')

pwhl_css = input(#2157f3, ''
  , inline = 'weekly'
  , group = 'Highs & Lows MTF')

//Monthly
show_pmhl = input(true, 'Monthly'
  , inline = 'monthly'
  , group = 'Highs & Lows MTF')

pmhl_style = input.string('····', ''
  , options = ['⎯⎯⎯', '----', '····']
  , inline = 'monthly'
  , group = 'Highs & Lows MTF')

pmhl_css = input(#2157f3, ''
  , inline = 'monthly'
  , group = 'Highs & Lows MTF')

//----------------------------------------}
//Premium/Discount zones
//----------------------------------------{
show_sd = input(true, 'Premium/Discount Zones'
  , group = 'Premium & Discount Zones'
  , tooltip = PED_ZONES)

premium_css = input.color(#ffc800, 'Premium Zone'
  , group = 'Premium & Discount Zones')

eq_css = input.color(#b2b5be, 'Equilibrium Zone'
  , group = 'Premium & Discount Zones')

discount_css = input.color(#00c8ff, 'Discount Zone'
  , group = 'Premium & Discount Zones')

//-----------------------------------------------------------------------------}
//Functions
//-----------------------------------------------------------------------------{
n = bar_index

atr = ta.atr(200)
cmean_range = ta.cum(high - low) / (n + 1)

//Order block volatility threshold
ob_threshold = ob_filter == 'Atr' ? atr : cmean_range

//ATR used to qualify displacement candles for ICT order blocks
disp_atr = ta.atr(14)

//Per-bar history of both thresholds for ob_coord, kept in ring buffers indexed by bar_index.
//ob_coord only runs on structure breaks, and a series read with [i] inside a conditionally called function
//only has history from those calls: ob_threshold[i] and disp_atr[i] returned the previous break's value
//for every i > 0 (Pine logs showed 22.7 for every candle of a leg whose real ATR was 13-16)
var ob_thr_ring   = array.new_float(501, na)
var disp_atr_ring = array.new_float(501, na)
array.set(ob_thr_ring, n % 501, ob_threshold)
array.set(disp_atr_ring, n % 501, disp_atr)

//Threshold values i bars ago (i <= 500)
ob_thr_at(i)   => array.get(ob_thr_ring, (n - i) % 501)
disp_atr_at(i) => array.get(disp_atr_ring, (n - i) % 501)

//Drawing range: price range of the last AOI_BARS chart bars (about one screen), widened on each side by the
//input share of that range. Objects outside it are not drawn, so they can't stretch the price scale.
//The previous limit (input x ATR of the next higher timeframe) did not follow the screen: on 1m-15m it let in
//objects several screens away, on 4H and above it hid zones that were on screen
AOI_BARS = 120
aoi_len  = math.min(AOI_BARS, bar_index + 1)
aoi_hi   = ta.highest(high, aoi_len)
aoi_lo   = ta.lowest(low, aoi_len)
aoi_pad  = aoi_max_dist > 0 ? aoi_max_dist * (aoi_hi - aoi_lo) : na

//Distance from the close to a zone (0 when price is inside it)
zone_dist(top, btm) => math.max(btm - close, close - top, 0.)

//True when a zone (or a level: top == btm) reaches into the drawing range
aoi_ok(top, btm) => na(aoi_pad) or (btm <= aoi_hi + aoi_pad and top >= aoi_lo - aoi_pad)

//Bar duration in ms, used to extend time-based boxes into the future
bar_ms = timeframe.in_seconds() * 1000

//Previous completed HTF candle high/low/open time (non-repainting with lookahead_on)
prev_hl() => [high[1], low[1], time[1], time_close[1]]

//Higher timeframe ohlc offset by one bar (non-repainting with lookahead_on) + open time of the middle candle
get_ohlc_htf()=> [close[2], open[2], high[1], low[1], high[3], low[3], time[2]]

//Display Structure function
display_Structure(x, y, txt, css, dashed, down, lbl_size)=>
    var line structure_line = na
    var label structure_lbl = na
    if mode == 'Present'
        line.delete(structure_line)
        label.delete(structure_lbl)
    structure_line := line.new(x, y, n, y
      , color = css
      , style = dashed ? line.style_dashed : line.style_solid)

    structure_lbl := label.new(int(math.avg(x, n)), y, txt
      , color = TRANSP_CSS
      , textcolor = css
      , style = down ? label.style_label_down : label.style_label_up
      , size = lbl_size)

//Swings detection/measurements
swings(len)=>
    var os = 0

    upper = ta.highest(len)
    lower = ta.lowest(len)

    os := high[len] > upper ? 0 : low[len] < lower ? 1 : os[1]

    top = os == 0 and os[1] != 0 ? high[len] : 0
    btm = os == 1 and os[1] != 1 ? low[len] : 0

    [top, btm]

//Order block coordinates function
//target_trig (speed only): [0] highest bottom of the bullish blocks, [1] lowest top of the bearish blocks
ob_coord(use_max, loc, target_top, target_btm, target_left, target_type, target_trig)=>
    float min = na
    float max = na
    idx = 1
    found = false

    //Search window: the structure interval, capped by the max_bars_back buffer
    last_i = math.max(math.min(n - loc - 1, 499), 1)

    if ob_candle == 'Opposite Candle (ICT)'
        //Walk back from the breaking bar to the most recent displacement candle of the breaking leg.
        //The OB is the first opposite-color candle before it (the last one before the displacement).
        //It only counts when it is not a volatile outlier (Order Block Filter) and no later candle closed
        //through it before the break; otherwise there is no OB (an older candle is never substituted)
        disp_seen = false
        float close_ext = na  //lowest close (bullish) / highest close (bearish) after the candidate
        for i = 0 to last_i
            if i > 0 and disp_seen and (use_max ? close[i] > open[i] : close[i] < open[i])
                ok_size  = (high[i] - low[i]) < ob_thr_at(i) * 2
                ok_close = na(close_ext) or (use_max ? close_ext <= high[i] : close_ext >= low[i])
                if ok_size and ok_close
                    min := low[i]
                    max := high[i]
                    idx := i
                    found := true
                break

            signed_body = use_max ? open[i] - close[i] : close[i] - open[i]
            if signed_body > 0 and signed_body >= ob_disp_mult * disp_atr_at(i)
                disp_seen := true

            close_ext := na(close_ext) ? close[i] : use_max ? math.max(close_ext, close[i]) : math.min(close_ext, close[i])
    else
        //Extreme candle of the leg (LuxAlgo)
        if use_max
            for i = 1 to last_i
                if (high[i] - low[i]) < ob_thr_at(i) * 2 and (na(max) or high[i] > max)
                    max := high[i]
                    min := low[i]
                    idx := i
                    found := true
        else
            for i = 1 to last_i
                if (high[i] - low[i]) < ob_thr_at(i) * 2 and (na(min) or low[i] < min)
                    min := low[i]
                    max := high[i]
                    idx := i
                    found := true

    if found
        array.unshift(target_top, max)
        array.unshift(target_btm, min)
        array.unshift(target_left, time[idx])
        array.unshift(target_type, use_max ? -1 : 1)

        trig = array.get(target_trig, use_max ? 1 : 0)
        array.set(target_trig, use_max ? 1 : 0, use_max ? (na(trig) ? max : math.min(trig, max)) : (na(trig) ? min : math.max(trig, min)))

        //Keep the arrays bounded; only the most recent blocks are ever displayed
        if array.size(target_type) > 100
            array.pop(target_top)
            array.pop(target_btm)
            array.pop(target_left)
            array.pop(target_type)

//Set order blocks
display_ob(boxes, target_top, target_btm, target_left, target_type, show_last, swing, size)=>
    //Rebuilt on the last bar: the boxes are then the newest drawings, so TradingView's
    //oldest-first cleanup (500 box limit) can never delete them
    for bx in boxes
        box.delete(bx)
    array.clear(boxes)

    //Show the blocks nearest to price (not just the most recent ones), skipping far-away blocks
    picked = array.new_int(0)
    if size > 0
        for k = 1 to show_last
            int best = -1
            float best_d = na
            for i = 0 to size - 1
                d = zone_dist(array.get(target_top, i), array.get(target_btm, i))
                if not array.includes(picked, i) and aoi_ok(array.get(target_top, i), array.get(target_btm, i)) and (na(best_d) or d < best_d)
                    best := i
                    best_d := d
            if best < 0
                break
            array.push(picked, best)

    for i in picked
        is_bull = array.get(target_type, i) == 1
        color css = na
        color border_css = na

        if style == 'Monochrome'
            css := is_bull ? color.new(#b2b5be, 80) : color.new(#5d606b, 80)
            border_css := swing ? (is_bull ? #b2b5be : #5d606b) : css
        else
            css := swing ? (is_bull ? bull_ob_css : bear_ob_css) : (is_bull ? ibull_ob_css : ibear_ob_css)
            border_css := css

        array.push(boxes, box.new(array.get(target_left, i), array.get(target_top, i), array.get(target_left, i), array.get(target_btm, i)
          , xloc = xloc.bar_time
          , extend = extend.right
          , border_color = border_css
          , bgcolor = css))

//Line Style function
get_line_style(style) =>
    out = switch style
        '⎯⎯⎯'  => line.style_solid
        '----' => line.style_dashed
        '····' => line.style_dotted

//Bar time where the previous HTF candle printed its high/low, so each level starts at its origin candle
//Must run on every bar to keep its running state
htf_extreme_time(tf)=>
    var float cur_h = na
    var float cur_l = na
    var int cur_ht = na
    var int cur_lt = na
    var float prev_h = na
    var float prev_l = na
    var int prev_ht = na
    var int prev_lt = na

    if timeframe.change(tf)
        prev_h := cur_h
        prev_l := cur_l
        prev_ht := cur_ht
        prev_lt := cur_lt
        cur_h := high
        cur_l := low
        cur_ht := time
        cur_lt := time
    else
        if na(cur_h) or high > cur_h
            cur_h := high
            cur_ht := time
        if na(cur_l) or low < cur_l
            cur_l := low
            cur_lt := time

    [prev_h, prev_l, prev_ht, prev_lt]

//Use the tracked origin when it matches. A weekly/multi-day candle can straddle a month boundary,
//so calendar-bucket tracking can miss the true wick and the month-open fallback lands between bars.
//Before falling back, search loaded chart candles that overlap the completed reference period.
//Keep the actual HTF price; a wick from another period or a merely nearby price is never substituted.
level_anchor(track_y, track_x, level, period_start, period_end, is_high)=>
    matched = not na(track_x) and not na(track_y) and math.abs(track_y - level) <= syminfo.mintick * 0.5
    int anchor = matched ? track_x : period_start
    if barstate.islast and not matched and not na(level) and not na(period_start) and not na(period_end)
        for i = 0 to math.min(bar_index, 999)
            if time_close[i] <= period_start
                break
            wick = is_high ? high[i] : low[i]
            if time[i] < period_end and time_close[i] > period_start and math.abs(wick - level) <= syminfo.mintick * 0.5
                anchor := time[i]
                break
    anchor

//Set line/labels function for previous high/lows
phl(show, h, l, hx, lx, tf, css, lstyle, label_bars)=>
    var line high_line = na
    var label high_lbl = na
    var line low_line = na
    var label low_lbl = na

    //Rebuilt on the last bar so the drawing-limit cleanup can never remove them
    if barstate.islast
        line.delete(high_line)
        label.delete(high_lbl)
        line.delete(low_line)
        label.delete(low_lbl)

        // Separate D/W/M label columns without moving any reference price.
        ext = time + bar_ms * label_bars
        period_name = tf == 'D' ? 'Day' : tf == 'W' ? 'Week' : 'Month'

        if show and aoi_ok(h, h)
            high_line := line.new(hx, h, ext, h
              , xloc = xloc.bar_time
              , color = css
              , style = get_line_style(lstyle))
            high_lbl := label.new(ext, h, str.format('P{0}H', tf)
              , xloc = xloc.bar_time
              , color = color.new(css, 0)
              , textcolor = color.white
              , tooltip = 'Previous ' + period_name + ' High: ' + str.tostring(h, format.mintick)
              , size = size.small
              , style = label.style_label_left)

        if show and aoi_ok(l, l)
            low_line := line.new(lx, l, ext, l
              , xloc = xloc.bar_time
              , color = css
              , style = get_line_style(lstyle))
            low_lbl := label.new(ext, l, str.format('P{0}L', tf)
              , xloc = xloc.bar_time
              , color = color.new(css, 0)
              , textcolor = color.white
              , tooltip = 'Previous ' + period_name + ' Low: ' + str.tostring(l, format.mintick)
              , size = size.small
              , style = label.style_label_left)

//-----------------------------------------------------------------------------}
//Global variables
//-----------------------------------------------------------------------------{
var trend = 0, var itrend = 0

var float top_y = na
var top_x = 0
var float btm_y = na
var btm_x = 0

var float itop_y = na
var itop_x = 0
var float ibtm_y = na
var ibtm_x = 0

var trail_up = high, var trail_dn = low
var trail_up_x = 0,  var trail_dn_x = 0

var top_cross = true,  var btm_cross = true
var itop_cross = true, var ibtm_cross = true

var txt_top = '',  var txt_btm = ''

//Alerts
bull_choch_alert = false
bull_bos_alert   = false

bear_choch_alert = false
bear_bos_alert   = false

bull_ichoch_alert = false
bull_ibos_alert   = false

bear_ichoch_alert = false
bear_ibos_alert   = false

bull_iob_break = false
bear_iob_break = false

bull_ob_break = false
bear_ob_break = false

eqh_alert = false
eql_alert = false

//Structure colors
var bull_css = style == 'Monochrome' ? #b2b5be
  : swing_bull_css

var bear_css = style == 'Monochrome' ? #b2b5be
  : swing_bear_css

var ibull_css = style == 'Monochrome' ? #b2b5be
  : swing_ibull_css

var ibear_css = style == 'Monochrome' ? #b2b5be
  : swing_ibear_css

//Swings
[top, btm] = swings(length)

effectiveILength = math.min(ilength, math.max(length - 1, 2))
[itop, ibtm] = swings(effectiveILength)

//-----------------------------------------------------------------------------}
//Pivot High
//-----------------------------------------------------------------------------{
var line extend_top = na

var label extend_top_lbl = na
var label top_lbl_last = na

//Swing points, breaks and invalidations are only committed on a closed bar (no intrabar flicker)
if top != 0 and barstate.isconfirmed
    top_cross := true
    txt_top := na(top_y) ? 'H' : top > top_y ? 'HH' : 'LH'

    if show_swings
        top_lbl = label.new(n-length, top, txt_top
          , color = TRANSP_CSS
          , textcolor = bear_css
          , style = label.style_label_down
          , size = size.small)

        //Present mode keeps only the latest label ([1] on a block-local variable is not a reliable handle)
        if mode == 'Present'
            label.delete(top_lbl_last)
        top_lbl_last := top_lbl

    //Extend recent top to last bar
    if show_hl_swings
        line.delete(extend_top[1])
        extend_top := line.new(n-length, top, n, top
          , color = bear_css)

    top_y := top
    top_x := n - length

    trail_up := top
    trail_up_x := n - length

if itop != 0 and barstate.isconfirmed
    itop_cross := true

    itop_y := itop
    itop_x := n - effectiveILength

//Trailing maximum
trail_up := math.max(high, trail_up)
trail_up_x := trail_up == high ? n : trail_up_x

//Set top extension label/line (rebuilt on the last bar so the drawing-limit cleanup can't remove them)
if barstate.islast and show_hl_swings
    line.delete(extend_top)
    extend_top := line.new(trail_up_x, trail_up, n + 20, trail_up
      , color = bear_css)

    label.delete(extend_top_lbl)
    extend_top_lbl := label.new(n + 20, trail_up, trend < 0 ? 'Strong High' : 'Weak High'
      , color = TRANSP_CSS
      , textcolor = bear_css
      , style = label.style_label_down
      , size = size.tiny)

//-----------------------------------------------------------------------------}
//Pivot Low
//-----------------------------------------------------------------------------{
var line extend_btm = na

var label extend_btm_lbl = na
var label btm_lbl_last = na

if btm != 0 and barstate.isconfirmed
    btm_cross := true
    txt_btm := na(btm_y) ? 'L' : btm < btm_y ? 'LL' : 'HL'

    if show_swings
        btm_lbl = label.new(n - length, btm, txt_btm
          , color = TRANSP_CSS
          , textcolor = bull_css
          , style = label.style_label_up
          , size = size.small)

        if mode == 'Present'
            label.delete(btm_lbl_last)
        btm_lbl_last := btm_lbl

    //Extend recent btm to last bar
    if show_hl_swings
        line.delete(extend_btm[1])
        extend_btm := line.new(n - length, btm, n, btm
          , color = bull_css)

    btm_y := btm
    btm_x := n-length

    trail_dn := btm
    trail_dn_x := n-length

if ibtm != 0 and barstate.isconfirmed
    ibtm_cross := true

    ibtm_y := ibtm
    ibtm_x := n - effectiveILength

//Trailing minimum
trail_dn := math.min(low, trail_dn)
trail_dn_x := trail_dn == low ? n : trail_dn_x

//Set btm extension label/line (rebuilt on the last bar so the drawing-limit cleanup can't remove them)
if barstate.islast and show_hl_swings
    line.delete(extend_btm)
    extend_btm := line.new(trail_dn_x, trail_dn, n + 20, trail_dn
      , color = bull_css)

    label.delete(extend_btm_lbl)
    extend_btm_lbl := label.new(n + 20, trail_dn, trend > 0 ? 'Strong Low' : 'Weak Low'
      , color = TRANSP_CSS
      , textcolor = bull_css
      , style = label.style_label_up
      , size = size.tiny)

//-----------------------------------------------------------------------------}
//Order Blocks Arrays
//-----------------------------------------------------------------------------{
var iob_top = array.new_float(0)
var iob_btm = array.new_float(0)
var iob_left = array.new_int(0)
var iob_type = array.new_int(0)

var ob_top = array.new_float(0)
var ob_btm = array.new_float(0)
var ob_left = array.new_int(0)
var ob_type = array.new_int(0)

//Invalidation triggers (speed only), see ob_coord
var iob_trig = array.new_float(2, na)
var ob_trig = array.new_float(2, na)

//-----------------------------------------------------------------------------}
//Pivot High BOS/CHoCH
//-----------------------------------------------------------------------------{
//Filtering
var bull_concordant = true

//Breakout candle must close in the upper half of its range (old formula mixed a price with a distance)
if ifilter_confluence
    bull_concordant := close - low >= high - close

//Detect internal bullish Structure
//State check (not a cross): a break candle rejected by the confluence filter no longer loses the break for good,
//the next valid close beyond the level confirms it. itop_cross keeps it to one break per pivot
if not na(itop_y) and close > itop_y and itop_cross and (na(top_y) or top_y != itop_y) and bull_concordant and barstate.isconfirmed
    bool choch = false

    if itrend < 0
        choch := true
        bull_ichoch_alert := true
    else
        bull_ibos_alert := true

    txt = choch ? 'CHoCH' : 'BOS'

    if show_internals
        if show_ibull == 'All' or (show_ibull == 'BOS' and not choch) or (show_ibull == 'CHoCH' and choch)
            display_Structure(itop_x, itop_y, txt, ibull_css, true, true, size.tiny)

    itop_cross := false
    itrend := 1

    //Internal Order Block
    if show_iob
        ob_coord(false, itop_x, iob_top, iob_btm, iob_left, iob_type, iob_trig)

//Detect bullish Structure
if ta.crossover(close, top_y) and top_cross and barstate.isconfirmed
    bool choch = false

    if trend < 0
        choch := true
        bull_choch_alert := true
    else
        bull_bos_alert := true

    txt = choch ? 'CHoCH' : 'BOS'

    if show_Structure
        if show_bull == 'All' or (show_bull == 'BOS' and not choch) or (show_bull == 'CHoCH' and choch)
            display_Structure(top_x, top_y, txt, bull_css, false, true, size.small)

    //Order Block
    if show_ob
        ob_coord(false, top_x, ob_top, ob_btm, ob_left, ob_type, ob_trig)

    top_cross := false
    trend := 1

//-----------------------------------------------------------------------------}
//Pivot Low BOS/CHoCH
//-----------------------------------------------------------------------------{
var bear_concordant = true

//Breakdown candle must close in the lower half of its range
if ifilter_confluence
    bear_concordant := high - close >= close - low

//Detect internal bearish Structure
if not na(ibtm_y) and close < ibtm_y and ibtm_cross and (na(btm_y) or btm_y != ibtm_y) and bear_concordant and barstate.isconfirmed
    bool choch = false

    if itrend > 0
        choch := true
        bear_ichoch_alert := true
    else
        bear_ibos_alert := true

    txt = choch ? 'CHoCH' : 'BOS'

    if show_internals
        if show_ibear == 'All' or (show_ibear == 'BOS' and not choch) or (show_ibear == 'CHoCH' and choch)
            display_Structure(ibtm_x, ibtm_y, txt, ibear_css, true, false, size.tiny)

    ibtm_cross := false
    itrend := -1

    //Internal Order Block
    if show_iob
        ob_coord(true, ibtm_x, iob_top, iob_btm, iob_left, iob_type, iob_trig)

//Detect bearish Structure
if ta.crossunder(close, btm_y) and btm_cross and barstate.isconfirmed
    bool choch = false

    if trend > 0
        choch := true
        bear_choch_alert := true
    else
        bear_bos_alert := true

    txt = choch ? 'CHoCH' : 'BOS'

    if show_Structure
        if show_bear == 'All' or (show_bear == 'BOS' and not choch) or (show_bear == 'CHoCH' and choch)
            display_Structure(btm_x, btm_y, txt, bear_css, false, false, size.small)

    //Order Block
    if show_ob
        ob_coord(true, btm_x, ob_top, ob_btm, ob_left, ob_type, ob_trig)

    btm_cross := false
    trend := -1

//-----------------------------------------------------------------------------}
//Order Blocks
//-----------------------------------------------------------------------------{
//Set order blocks
var iob_boxes = array.new_box(0)
var ob_boxes = array.new_box(0)

//Delete internal order blocks box coordinates if top/bottom is broken
//Walk backward by real index so removals never skip or hit the wrong block
//The scan only runs when the close is beyond a trigger (no block can break otherwise); it rebuilds the triggers
if array.size(iob_type) > 0 and barstate.isconfirmed and ((not na(array.get(iob_trig, 0)) and close < array.get(iob_trig, 0)) or (not na(array.get(iob_trig, 1)) and close > array.get(iob_trig, 1)))
    float bull_trig = na
    float bear_trig = na
    for index = array.size(iob_type) - 1 to 0
        element = array.get(iob_type, index)

        if close < array.get(iob_btm, index) and element == 1
            array.remove(iob_top, index)
            array.remove(iob_btm, index)
            array.remove(iob_left, index)
            array.remove(iob_type, index)
            bull_iob_break := true

        else if close > array.get(iob_top, index) and element == -1
            array.remove(iob_top, index)
            array.remove(iob_btm, index)
            array.remove(iob_left, index)
            array.remove(iob_type, index)
            bear_iob_break := true

        else if element == 1
            bull_trig := na(bull_trig) ? array.get(iob_btm, index) : math.max(bull_trig, array.get(iob_btm, index))
        else
            bear_trig := na(bear_trig) ? array.get(iob_top, index) : math.min(bear_trig, array.get(iob_top, index))

    array.set(iob_trig, 0, bull_trig)
    array.set(iob_trig, 1, bear_trig)

//Delete swing order blocks box coordinates if top/bottom is broken
if array.size(ob_type) > 0 and barstate.isconfirmed and ((not na(array.get(ob_trig, 0)) and close < array.get(ob_trig, 0)) or (not na(array.get(ob_trig, 1)) and close > array.get(ob_trig, 1)))
    float bull_trig = na
    float bear_trig = na
    for index = array.size(ob_type) - 1 to 0
        element = array.get(ob_type, index)

        if close < array.get(ob_btm, index) and element == 1
            array.remove(ob_top, index)
            array.remove(ob_btm, index)
            array.remove(ob_left, index)
            array.remove(ob_type, index)
            bull_ob_break := true

        else if close > array.get(ob_top, index) and element == -1
            array.remove(ob_top, index)
            array.remove(ob_btm, index)
            array.remove(ob_left, index)
            array.remove(ob_type, index)
            bear_ob_break := true

        else if element == 1
            bull_trig := na(bull_trig) ? array.get(ob_btm, index) : math.max(bull_trig, array.get(ob_btm, index))
        else
            bear_trig := na(bear_trig) ? array.get(ob_top, index) : math.min(bear_trig, array.get(ob_top, index))

    array.set(ob_trig, 0, bull_trig)
    array.set(ob_trig, 1, bear_trig)

iob_size = array.size(iob_type)
ob_size = array.size(ob_type)

//Runs even when no block is left so invalidated boxes get hidden
if barstate.islast
    display_ob(iob_boxes, iob_top, iob_btm, iob_left, iob_type, iob_showlast, false, iob_size)
    display_ob(ob_boxes, ob_top, ob_btm, ob_left, ob_type, ob_showlast, true, ob_size)

//-----------------------------------------------------------------------------}
//EQH/EQL
//-----------------------------------------------------------------------------{
var float eq_prev_top = na
var eq_top_x = 0

var float eq_prev_btm = na
var eq_btm_x = 0

//Latest EQH/EQL drawings, deleted when a new one prints in Present mode
var line eqh_line_last = na
var label eqh_lbl_last = na
var line eql_line_last = na
var label eql_lbl_last = na

if show_eq
    eq_top = ta.pivothigh(eq_len, eq_len)
    eq_btm = ta.pivotlow(eq_len, eq_len)

    if not na(eq_top) and barstate.isconfirmed
        max = math.max(eq_top, eq_prev_top)
        min = math.min(eq_top, eq_prev_top)

        if not na(eq_prev_top) and not na(atr) and max - min <= math.max(atr * eq_threshold, syminfo.mintick * 0.5)
            eqh_line = line.new(eq_top_x, eq_prev_top, n-eq_len, eq_top
              , color = bear_css
              , style = line.style_dotted)

            eqh_lbl = label.new(int(math.avg(n-eq_len, eq_top_x)), eq_top, 'EQH'
              , color = #00000000
              , textcolor = bear_css
              , style = label.style_label_down
              , size = size.tiny)

            if mode == 'Present'
                line.delete(eqh_line_last)
                label.delete(eqh_lbl_last)
            eqh_line_last := eqh_line
            eqh_lbl_last := eqh_lbl

            eqh_alert := true

        eq_prev_top := eq_top
        eq_top_x := n-eq_len

    if not na(eq_btm) and barstate.isconfirmed
        max = math.max(eq_btm, eq_prev_btm)
        min = math.min(eq_btm, eq_prev_btm)

        if not na(eq_prev_btm) and not na(atr) and max - min <= math.max(atr * eq_threshold, syminfo.mintick * 0.5)
            eql_line = line.new(eq_btm_x, eq_prev_btm, n-eq_len, eq_btm
              , color = bull_css
              , style = line.style_dotted)

            eql_lbl = label.new(int(math.avg(n-eq_len, eq_btm_x)), eq_btm, 'EQL'
              , color = #00000000
              , textcolor = bull_css
              , style = label.style_label_up
              , size = size.tiny)

            eql_alert := true

            if mode == 'Present'
                line.delete(eql_line_last)
                label.delete(eql_lbl_last)
            eql_line_last := eql_line
            eql_lbl_last := eql_lbl

        eq_prev_btm := eq_btm
        eq_btm_x := n-eq_len

//-----------------------------------------------------------------------------}
//Fair Value Gaps
//-----------------------------------------------------------------------------{
//Open gaps are tracked as data (top, bottom, origin time, detection time), newest first,
//and drawn on the last bar only
var bull_fvg_top  = array.new_float(0)
var bull_fvg_btm  = array.new_float(0)
var bull_fvg_left = array.new_int(0)
var bull_fvg_born = array.new_int(0)

var bear_fvg_top  = array.new_float(0)
var bear_fvg_btm  = array.new_float(0)
var bear_fvg_left = array.new_int(0)
var bear_fvg_born = array.new_int(0)

var fvg_boxes = array.new_box(0)

bullish_fvg_cnd = false
bearish_fvg_cnd = false

//FVG timeframe must be >= the chart timeframe. A higher timeframe only uses its last completed candles,
//so gaps appear at the same place in history and in realtime. A lower one is not possible on this chart:
//the script falls back to chart-timeframe gaps and says so with a label on the last bar
fvg_tf_sec = timeframe.in_seconds(fvg_tf)
fvg_htf = fvg_tf_sec > timeframe.in_seconds()
//Any explicit timeframe that is not usable here (lower, tick or second based) is reported
fvg_tf_too_low = not fvg_htf and fvg_tf != '' and fvg_tf != timeframe.period

[htf_c1, htf_o1, htf_h, htf_l, htf_h2, htf_l2, htf_t1] =
  request.security(syminfo.tickerid, fvg_htf ? fvg_tf : timeframe.period, get_ohlc_htf(), lookahead = barmerge.lookahead_on)

src_c1 = fvg_htf ? htf_c1 : close[1]
src_o1 = fvg_htf ? htf_o1 : open[1]
src_h  = fvg_htf ? htf_h  : high
src_l  = fvg_htf ? htf_l  : low
src_h2 = fvg_htf ? htf_h2 : high[2]
src_l2 = fvg_htf ? htf_l2 : low[2]
//Box origin: open time of the middle candle of the 3-candle gap (the real HTF candle on a higher timeframe)
src_t1 = fvg_htf ? htf_t1 : time[1]

change_tf = fvg_htf ? timeframe.change(fvg_tf) : true
delta_per = (src_c1 - src_o1) / src_o1 * 100

//Auto threshold: 2x the average absolute body % of the FVG timeframe candles
//(averaged over FVG timeframe candles, not chart bars, so a higher timeframe isn't under-filtered)
threshold = fvg_auto ? ta.cum(change_tf ? nz(math.abs(delta_per)) : 0) / math.max(ta.cum(change_tf ? 1 : 0), 1) * 2
  : 0

//Right edge of open gap boxes, Extend FVG bars past the current bar
fvg_right = time + fvg_extend * bar_ms

if show_fvg
    //FVG conditions
    bullish_fvg_cnd := src_l > src_h2
      and src_c1 > src_h2
      and delta_per > threshold
      and change_tf
      and barstate.isconfirmed

    bearish_fvg_cnd := src_h < src_l2
      and src_c1 < src_l2
      and -delta_per > threshold
      and change_tf
      and barstate.isconfirmed

    if bullish_fvg_cnd
        array.unshift(bull_fvg_top, src_l)
        array.unshift(bull_fvg_btm, src_h2)
        array.unshift(bull_fvg_left, src_t1)
        array.unshift(bull_fvg_born, time)

    if bearish_fvg_cnd
        array.unshift(bear_fvg_top, src_l2)
        array.unshift(bear_fvg_btm, src_h)
        array.unshift(bear_fvg_left, src_t1)
        array.unshift(bear_fvg_born, time)

    //Lifecycle: a gap is filled when price reaches its far edge (exact touch included).
    //Filled gaps, and the oldest gaps beyond the max count, are removed
    if array.size(bull_fvg_top) > 0
        for i = array.size(bull_fvg_top) - 1 to 0
            if low <= array.get(bull_fvg_btm, i) or i >= fvg_max_active
                array.remove(bull_fvg_top, i)
                array.remove(bull_fvg_btm, i)
                array.remove(bull_fvg_left, i)
                array.remove(bull_fvg_born, i)

    if array.size(bear_fvg_top) > 0
        for i = array.size(bear_fvg_top) - 1 to 0
            if high >= array.get(bear_fvg_top, i) or i >= fvg_max_active
                array.remove(bear_fvg_top, i)
                array.remove(bear_fvg_btm, i)
                array.remove(bear_fvg_left, i)
                array.remove(bear_fvg_born, i)

//Draw one gap as two halves split at its midpoint (consequent encroachment)
draw_fvg(top, btm, left, born, css) =>
    right = fvg_extend_active ? fvg_right : born + fvg_extend * bar_ms
    mid = math.avg(top, btm)
    array.push(fvg_boxes, box.new(left, top, right, mid, xloc = xloc.bar_time, border_color = css, bgcolor = css))
    array.push(fvg_boxes, box.new(left, mid, right, btm, xloc = xloc.bar_time, border_color = css, bgcolor = css))

//Rebuilt on the last bar (always the newest drawings); gaps far from price are not drawn
if barstate.islast
    for bx in fvg_boxes
        box.delete(bx)
    array.clear(fvg_boxes)

    if show_fvg
        if array.size(bull_fvg_top) > 0
            for i = 0 to array.size(bull_fvg_top) - 1
                if aoi_ok(array.get(bull_fvg_top, i), array.get(bull_fvg_btm, i))
                    draw_fvg(array.get(bull_fvg_top, i), array.get(bull_fvg_btm, i), array.get(bull_fvg_left, i), array.get(bull_fvg_born, i), bull_fvg_css)
        if array.size(bear_fvg_top) > 0
            for i = 0 to array.size(bear_fvg_top) - 1
                if aoi_ok(array.get(bear_fvg_top, i), array.get(bear_fvg_btm, i))
                    draw_fvg(array.get(bear_fvg_top, i), array.get(bear_fvg_btm, i), array.get(bear_fvg_left, i), array.get(bear_fvg_born, i), bear_fvg_css)

//Tell the user when the selected FVG timeframe cannot be used on this chart
var label fvg_tf_warn = na
if barstate.islast
    label.delete(fvg_tf_warn)
    fvg_tf_warn := na
    if show_fvg and fvg_tf_too_low
        fvg_tf_warn := label.new(bar_index, high
          , 'FVG timeframe ' + fvg_tf + ' is below the chart timeframe: showing ' + timeframe.period + ' FVGs'
          , color = color.new(color.orange, 20)
          , textcolor = color.white
          , style = label.style_label_lower_left
          , size = size.small)

//-----------------------------------------------------------------------------}
//Previous day/week high/lows
//-----------------------------------------------------------------------------{
//Previous *completed* candle only: [1] offset + lookahead_on never leaks the current HTF candle
//Daily high/low
[pdh, pdl, pdt, pde] = request.security(syminfo.tickerid, 'D', prev_hl()
  , lookahead = barmerge.lookahead_on)

//Weekly high/low
[pwh, pwl, pwt, pwe] = request.security(syminfo.tickerid, 'W', prev_hl()
  , lookahead = barmerge.lookahead_on)

//Monthly high/low
[pmh, pml, pmt, pme] = request.security(syminfo.tickerid, 'M', prev_hl()
  , lookahead = barmerge.lookahead_on)

//Origin candle of each level; falls back to the HTF candle open when history doesn't cover it
[pd_th, pd_tl, pd_hx, pd_lx] = htf_extreme_time('D')
[pw_th, pw_tl, pw_hx, pw_lx] = htf_extreme_time('W')
[pm_th, pm_tl, pm_hx, pm_lx] = htf_extreme_time('M')

//Each level is only drawn when the chart timeframe is not above it: on a weekly or monthly chart the daily
//request returns the day before the period began (a weekly chart showed last Friday's low as "PDL")
chart_sec = timeframe.in_seconds()

//Display Daily
phl(show_pdhl and chart_sec <= timeframe.in_seconds('D'), pdh, pdl, level_anchor(pd_th, pd_hx, pdh, pdt, pde, true), level_anchor(pd_tl, pd_lx, pdl, pdt, pde, false), 'D', pdhl_css, pdhl_style, 12)

//Display Weekly
phl(show_pwhl and chart_sec <= timeframe.in_seconds('W'), pwh, pwl, level_anchor(pw_th, pw_hx, pwh, pwt, pwe, true), level_anchor(pw_tl, pw_lx, pwl, pwt, pwe, false), 'W', pwhl_css, pwhl_style, 24)

//Display Monthly
phl(show_pmhl and chart_sec <= timeframe.in_seconds('M'), pmh, pml, level_anchor(pm_th, pm_hx, pmh, pmt, pme, true), level_anchor(pm_tl, pm_lx, pml, pmt, pme, false), 'M', pmhl_css, pmhl_style, 36)

//-----------------------------------------------------------------------------}
//Premium/Discount/Equilibrium zones
//-----------------------------------------------------------------------------{
var box premium = na
var label premium_lbl = na
var box eq = na
var label eq_lbl = na
var box discount = na
var label discount_lbl = na

//Show Premium/Discount Areas
//Rebuilt on the last bar so the drawing-limit cleanup can never remove them
if barstate.islast
    box.delete(premium)
    label.delete(premium_lbl)
    box.delete(eq)
    label.delete(eq_lbl)
    box.delete(discount)
    label.delete(discount_lbl)

    if show_sd
        avg = math.avg(trail_up, trail_dn)
        left = math.max(top_x, btm_x)
        mid = int(math.avg(left, n))

        premium := box.new(left, trail_up, n, .95 * trail_up + .05 * trail_dn
          , bgcolor = color.new(premium_css, 80)
          , border_color = na)
        premium_lbl := label.new(mid, trail_up, 'Premium'
          , color = TRANSP_CSS
          , textcolor = premium_css
          , style = label.style_label_down
          , size = size.small)

        eq := box.new(left, .525 * trail_up + .475 * trail_dn, n, .525 * trail_dn + .475 * trail_up
          , bgcolor = color.new(eq_css, 80)
          , border_color = na)
        eq_lbl := label.new(n, avg, 'Equilibrium'
          , color = TRANSP_CSS
          , textcolor = eq_css
          , style = label.style_label_left
          , size = size.small)

        discount := box.new(left, .95 * trail_dn + .05 * trail_up, n, trail_dn
          , bgcolor = color.new(discount_css, 80)
          , border_color = na)
        discount_lbl := label.new(mid, trail_dn, 'Discount'
          , color = TRANSP_CSS
          , textcolor = discount_css
          , style = label.style_label_up
          , size = size.small)

//-----------------------------------------------------------------------------}
//Trend
//-----------------------------------------------------------------------------{
var color trend_css = na

if show_trend
    if style == 'Colored'
        trend_css := itrend == 1 ? bull_css : bear_css
    else if style == 'Monochrome'
        trend_css := itrend == 1 ? #b2b5be : #5d606b

//Whole candle (body, border and wick) in the trend color, drawn over the chart candles (behind_chart = false).
//Candles closing with the trend are filled; pullback candles are hollow (chart background inside, which also
//covers the chart candle underneath)
with_trend = itrend == 1 ? close >= open : close <= open
plotcandle(open, high, low, close
  , color = na(trend_css) ? na : with_trend ? trend_css : chart.bg_color
  , wickcolor = trend_css
  , bordercolor = trend_css
  , editable = false)

//Fallback if the indicator is moved behind the chart (Visual Order): the chart's own candle bodies get the color
barcolor(trend_css, editable = false)

//-----------------------------------------------------------------------------}
//Alerts
//-----------------------------------------------------------------------------{
//Internal Structure
alertcondition(bull_ibos_alert, 'Internal Bullish BOS', 'Internal Bullish BOS formed')
alertcondition(bull_ichoch_alert, 'Internal Bullish CHoCH', 'Internal Bullish CHoCH formed')

alertcondition(bear_ibos_alert, 'Internal Bearish BOS', 'Internal Bearish BOS formed')
alertcondition(bear_ichoch_alert, 'Internal Bearish CHoCH', 'Internal Bearish CHoCH formed')

//Swing Structure
alertcondition(bull_bos_alert, 'Bullish BOS', 'Bullish BOS formed')
alertcondition(bull_choch_alert, 'Bullish CHoCH', 'Bullish CHoCH formed')

alertcondition(bear_bos_alert, 'Bearish BOS', 'Bearish BOS formed')
alertcondition(bear_choch_alert, 'Bearish CHoCH', 'Bearish CHoCH formed')

//order Blocks
alertcondition(bull_iob_break, 'Bullish Internal OB Breakout', 'Price broke bullish internal OB')
alertcondition(bear_iob_break, 'Bearish Internal OB Breakout', 'Price broke bearish internal OB')

alertcondition(bull_ob_break, 'Bullish OB Breakout', 'Price broke bullish swing OB')
alertcondition(bear_ob_break, 'Bearish OB Breakout', 'Price broke bearish swing OB')

//EQH/EQL
alertcondition(eqh_alert, 'Equal Highs', 'Equal highs detected')
alertcondition(eql_alert, 'Equal Lows', 'Equal lows detected')

//FVG
alertcondition(bullish_fvg_cnd, 'Bullish FVG', 'Bullish FVG formed')
alertcondition(bearish_fvg_cnd, 'Bearish FVG', 'Bearish FVG formed')

//-----------------------------------------------------------------------------}


ds_mode = input.string('ATR', 'Threshold Mode', options=['ATR', 'Percent'], group='Demand & Supply',
 tooltip=' --- Threshold Mode ---' + '\n\n' + 'ATR: every distance below is a multiple of ATR(14), so one setting fits every timeframe and adapts to gold volatility.' + '\n\n' +
 'Percent: the legacy fixed % inputs further down.')
ds_min_atr = input.float(2.0, 'Min departure (× ATR)', minval=0, step=0.25, group='Demand & Supply',
 tooltip='ATR mode. A zone is added once the bullish/bearish run away from the base candle covers this many ATRs (open to close).')
ds_max_atr = input.float(1.0, 'Max zone height (× ATR)', minval=0, step=0.25, group='Demand & Supply',
 tooltip='ATR mode. Zones taller than this are trimmed toward the base candle.')
ds_line_atr = input.float(10.0, 'Show lines within (× ATR)', minval=0, step=1, group='Demand & Supply',
 tooltip='ATR mode. Lines are shown for active zones within this distance of the close.')
ds_min_pc_change = input.float(title='Min % change (Percent mode)', defval=0.05, minval=0, step=0.01, group='Demand & Supply',
 tooltip=' --- Min % change ---' + '\n\n' + 'A zone is added if one candle or a run of bullish/bearish candles meets this minimum % change.' + '\n\n' +
 'Signed change is measured from the first departure candle open to the current close, divided by that first open. Demand requires a rise; supply requires a fall. Adjust the % for the pair and the timeframe.' + '\n' +
 'e.g. Crypto 15m 0.8% 1m 0.5%, Forex 15m 0.4%')
ds_max_pc_zone = input.float(title='Max % zone height (Percent mode)', defval=0.05, minval=0, step=0.2, group='Demand & Supply',
 tooltip=' --- Max % zone height ---' + '\n\n' + 'The zone height is decided by the size of the candle before a significant drop or rally.' + '\n\n' +
 'Setting a higher max % will keep the height closer to candle height.' + '\n' +
 'Setting a lower max % makes the boxes look a bit tidier.')
ds_line_pc_display = input.float(title='% line (Percent mode)', defval=3.0, step=0.5, minval=0, maxval=5, inline='line', group='Demand & Supply')
ds_line_max = input.int(title='Max line', defval=3, minval=1, maxval=5, inline='line', group='Demand & Supply',
 tooltip=' --- % Line  --- ' + '\n' + 'Display lines of active zones when the close is within this % of the line. Max is 5%.' + '\n\n' +
 ' --- Max Line  --- ' + '\n' + 'The maximum number of lines to display for each zone type.')
ds_max_zones = input.int(title='Max number of zones', defval=100, minval=1, step=10, maxval=150, group='Demand & Supply',
 tooltip=' --- Max number of zones ---' + '\n\n' + 'The maximum number of zones for each zone type.\nUp to 150 boxes per side, reserving drawing capacity for the independent OB, FVG and pivot systems. Oldest tested/invalidated zones leave first.')

ds_hours_offset = input.float(0.0, "Timezone offset (H)", minval=-12, maxval=14, group='Demand & Supply',
 tooltip=' --- Timezone offset (H)  --- ' + '\n' + 'If your chart timezone is not set set to UTC, set the offset in hours.' + '\n' +
 'Range: -12 to +14.'+ '\n\n' +
 'Time information is displayed when hovering over zone labels.')

showDemandZone = input.bool(title='Demand', defval=true, inline='demand_1', group='Demand & Supply')
demand_bord_col = input.color(title='Border', defval=color.rgb(10, 255, 2, 30), inline='demand_1', group='Demand & Supply')
demand_bg_col = input.color(title='Background', defval=color.rgb(10, 255, 2, 85), inline='demand_1', group='Demand & Supply',
 tooltip='Filled/solid = Fresh. A proximal wick touch makes the zone Tested (transparent/dotted). A confirmed close below its distal bottom makes demand Invalidated (transparent/dashed gray).')

showSupplyZone = input.bool(title='Supply', defval=true, inline='supply_1', group='Demand & Supply')
supply_bord_col = input.color(title='Border', defval=color.rgb(255, 0, 0, 30), inline='supply_1', group='Demand & Supply')
supply_bg_col = input.color(title='Background', defval=color.rgb(255, 0, 0, 85), inline='supply_1', group='Demand & Supply',
 tooltip='Filled/solid = Fresh. A proximal wick touch makes the zone Tested (transparent/dotted). A confirmed close above its distal top makes supply Invalidated (transparent/dashed gray).')

dsAlertDemand = input.bool(true, title='Demand', inline='ds_alert_1', group='Demand & Supply Alerts')
dsAlertSupply = input.bool(true, title='Supply', inline='ds_alert_1', group='Demand & Supply Alerts',
 tooltip=' --- Demand & Supply Alerts ---' + '\n\n' + 'Two types of alerts are sent:' + '\n' +
 '1. Hit: The price hits an active zone.' + '\n' + '2. Near: The price approaches the active zone.' + '\n\n' +
  ' --- Supply Example ---' + '\n' +
 '1. When the price is below the supply zone and the high hits the zone, an alert is sent.' + '\n' +
 '2. When the price is below the supply zone and the high is within the Near %, an alert is sent.')

ds_alert_mins_no_repeat = input.int(60, minval=0, maxval=120, title='Mins no repeat', group='Demand & Supply Alerts',
 tooltip=' --- Mins No Repeat ---' + '\n\n' + 'Wait x mins before sending a similar alert type for the same zone.' + '\n\n' +
 'Setting this to 0 will turn this feature off.' + '\n' +
 'Max = 120mins.')
ds_alerts_pc_near = input.float(1.5, title='Near %', step=0.1, minval=0, maxval=5, group='Demand & Supply Alerts',
 tooltip=' --- Near % ---' +
 '\n' + 'Percent mode. The alert is sent when the high or low is within this % of the zone. Max is 5%.')
ds_near_atr = input.float(1.0, 'Near (× ATR)', minval=0, step=0.25, group='Demand & Supply Alerts',
 tooltip='ATR mode. The near alert is sent when the high or low is within this many ATRs of the zone.')

// Effective % thresholds for this bar (ATR multiples converted to % of price)
ds_atr = ta.atr(14)
ds_atr_pc = close != 0 ? ds_atr / math.abs(close) * 100 : na
ds_line_pc_eff = ds_mode == 'ATR' ? ds_line_atr * ds_atr_pc : ds_line_pc_display
ds_near_pc_eff = ds_mode == 'ATR' ? ds_near_atr * ds_atr_pc : ds_alerts_pc_near
// Labels of zones closer together than this are staggered (1 ATR in ATR mode, legacy 0.7% otherwise)
ds_stagger_pc  = ds_mode == 'ATR' ? ds_atr_pc : 0.7

// ================================== //
// ---------->  Top Func  <---------- //
// ================================== //

get_pc_diff_abs(x_start, y_end) =>
    x_start != 0 ? math.abs((y_end - x_start) / x_start * 100) : na

get_amount_by_pc(amount, pc, add_minus) =>
    pc_amount = amount * (pc / 100)
    add_minus == 'add' ? amount + pc_amount : amount - pc_amount

// ================================== //
// ---->  Demand & Supply Vars  <---- //
// ================================== //

var milli_secs_per_bar =
 timeframe.isseconds ? timeframe.multiplier * 1000 :
 timeframe.isminutes ? timeframe.multiplier * 60 * 1000 :
 timeframe.isdaily ? timeframe.multiplier * 24 * 60 * 60 * 1000 :
 timeframe.isweekly ? timeframe.multiplier * 7 * 24 * 60 * 60 * 1000 : na

// Main labels with limited data
// Per-zone cooldowns survive realtime rollback; same-price zones retain independent identities.
varip demand_zones_alert_origin = array.new_int(0)
varip demand_zones_alert_sent = array.new_int(0)
var demand_zones_time = array.new_int(0)
var demand_zones_s1_active = array.new_bool(0)
var demand_zones_s1 = array.new_float(0)
var demand_zones_top = array.new_float(0)
var demand_zones_btm = array.new_float(0)
var demand_zones_state = array.new_int(0) // 0 Fresh, 1 Tested, 2 Invalidated
var demand_zones_box = array.new_box(0)

varip supply_zones_alert_origin = array.new_int(0)
varip supply_zones_alert_sent = array.new_int(0)
var supply_zones_time = array.new_int(0)
var supply_zones_s1 = array.new_float(0)
var supply_zones_s1_active = array.new_bool(0)
var supply_zones_top = array.new_float(0)
var supply_zones_btm = array.new_float(0)
var supply_zones_state = array.new_int(0)
var supply_zones_box = array.new_box(0)
var ds_registered_origin = array.new_int(2, na) // supply, demand; prevents recreation after eviction
// Invalidation triggers (speed only): [0] supply <= lowest top, [1] demand >= highest bottom of the zones not
// invalidated yet. The zone scan only runs when the close is beyond a trigger, then the trigger is recomputed
var ds_inval_level = array.new_float(2, na)

// Nearby-zone lines/labels, rebuilt on the last bar
var demand_zones_s1_line = array.new_line(0)
var demand_zones_s1_line_price = array.new_label(0)
var supply_zones_s1_line = array.new_line(0)
var supply_zones_s1_line_price = array.new_label(0)

// Alerts queued by the zone functions this execution; sent globally with alert.freq_all
// so several zones hit by one candle each get an alert
ds_alert_keys = array.new_string(0)
ds_alert_msgs = array.new_string(0)

// All data with active zones, sorted by price ascending (time array kept parallel)
// Active demand always sits below price and active supply above it, so the nearest zone is
// the last demand element / first supply element and scans can stop at the first far zone
var demand_zones_time_all = array.new_int(0)
var demand_zones_s1_all = array.new_float(0)
var supply_zones_time_all = array.new_int(0)
var supply_zones_s1_all = array.new_float(0)

bear_run = ta.barssince(open < close)
bull_run = ta.barssince(open > close)

// Capture the complete chosen base and first departure candle together. Subsequent bars read stored
// data, never open[run length] or high[run length], so even a >500-bar run is safe.
// Tiny-base fallback: the base is the older opposite candle plus the tiny candle after it. The proximal
// edge, body and time come from the older candle; the distal wick covers both base candles.
ds_tiny_base = get_pc_diff_abs(open[1], close[1]) < 0.02
var float d_open = na
var float d_low = na
var float d_close = na
var int d_time = na
var float d_run_open = na
var float d_first_low = na
var float d_after_close = na
var bool d_has_bull = false
var float s_open = na
var float s_high = na
var float s_close = na
var int s_time = na
var float s_run_open = na
var float s_first_high = na
var float s_after_close = na
var bool s_has_bear = false
if barstate.isconfirmed
    if bull_run == 1
        d_old = ds_tiny_base and open[2] > close[2]
        d_open := d_old ? open[2] : open[1]
        d_low := d_old ? math.min(low[2], low[1]) : low[1]
        d_close := d_old ? close[2] : close[1]
        d_time := d_old ? time[2] : time[1]
        d_run_open := open
        d_first_low := low
        d_after_close := d_old ? math.min(close[1], close) : close
        d_has_bull := close > open
    else if bull_run > 1
        d_after_close := math.min(d_after_close, close)
        d_has_bull := d_has_bull or close > open
    if bear_run == 1
        s_old = ds_tiny_base and open[2] < close[2]
        s_open := s_old ? open[2] : open[1]
        s_high := s_old ? math.max(high[2], high[1]) : high[1]
        s_close := s_old ? close[2] : close[1]
        s_time := s_old ? time[2] : time[1]
        s_run_open := open
        s_first_high := high
        s_after_close := s_old ? math.max(close[1], close) : close
        s_has_bear := close < open
    else if bear_run > 1
        s_after_close := math.max(s_after_close, close)
        s_has_bear := s_has_bear or close < open

// ================================== //
// ---->  Demand & Supply Func  <---- //
// ================================== //

get_month_bar_time(_bar_start, _add_minus, _num_bars) =>
    _add_minus_sign = _add_minus == 'add' ? 1 : -1

    _year_start = year(_bar_start)
    _month_start = month(_bar_start)
    _months_div_year = _num_bars / 12
    _year_change = _months_div_year >= 1 ? math.floor(_months_div_year) : 0
    _year = _year_start + (_year_change * _add_minus_sign)
    _month_change = _num_bars % 12
    _month = _month_start + (_month_change * _add_minus_sign)
    _year += _month > 12 ? 1 : _month < 1 ? -1 : 0
    _month += _month > 12 ? -12 : _month < 1 ? 12 : 0

    timestamp(_year, _month, 1, 0, 0, 0)

get_bar_time(_bar_start, _add_minus, _num_bars) =>
    _add_minus_sign = _add_minus == 'add' ? 1 : -1
    _bar_time =
     not na(milli_secs_per_bar) ? _bar_start + ((milli_secs_per_bar * _num_bars) * _add_minus_sign) :
     timeframe.ismonthly ? get_month_bar_time(_bar_start, _add_minus, _num_bars) : na

// Index where _val keeps an ascending array sorted (binary search, lower bound)
ds_sorted_index(_arr, _val) =>
    int _lo = 0
    int _hi = array.size(_arr)
    while _lo < _hi
        int _mid = math.floor((_lo + _hi) / 2)
        if array.get(_arr, _mid) < _val
            _lo := _mid + 1
        else
            _hi := _mid
    _lo

// Cooldowns only belong to live Fresh zones; eviction/touch removes the matching identity.
remove_ds_alert_origin(_type, _origin) =>
    _origins = _type == 'S' ? supply_zones_alert_origin : demand_zones_alert_origin
    _sent = _type == 'S' ? supply_zones_alert_sent : demand_zones_alert_sent
    _idx = array.indexof(_origins, _origin)
    if _idx >= 0
        array.remove(_origins, _idx)
        array.remove(_sent, _idx)

add_ds_zone(_zone_type) =>
    _isSupply = _zone_type == 'S'
    _showZone = (_zone_type == 'S' and showSupplyZone) or (_zone_type == 'D' and showDemandZone)
    _zones_time = _isSupply ? supply_zones_time : demand_zones_time
    _run = _isSupply ? bear_run : bull_run
    _base_open = _isSupply ? s_open : d_open
    _base_close = _isSupply ? s_close : d_close
    _run_open = _isSupply ? s_run_open : d_run_open
    _s1_time = _isSupply ? s_time : d_time
    _origin_slot = _isSupply ? 0 : 1
    _last_origin = array.get(ds_registered_origin, _origin_slot)
    // ATR uses an absolute PRICE distance; Percent uses the first departure OPEN as denominator.
    _departure = _isSupply ? _run_open - close : close - _run_open
    _min_departure = ds_mode == 'ATR' ? ds_min_atr * ds_atr : math.abs(_run_open) * ds_min_pc_change / 100
    _max_height = ds_mode == 'ATR' ? ds_max_atr * ds_atr : math.abs(_base_open) * ds_max_pc_zone / 100
    // Dojis can extend the base/run, but a neutral-only sequence is not directional displacement.
    _has_direction = _isSupply ? s_has_bear : d_has_bull

    if _run >= 1 and _has_direction and not na(_s1_time) and (na(_last_origin) or _last_origin != _s1_time) and _departure > 0 and _departure >= _min_departure and _max_height > 0 and barstate.isconfirmed
        _top = _isSupply ? math.max(s_high, s_first_high) : d_open
        _bot = _isSupply ? s_open : math.min(d_low, d_first_low)
        // Trim the far side. If the base BODY exceeds the cap, move the proximal edge toward
        // that same base's close; retain actual base/first-departure wick boundaries.
        if _top - _bot > _max_height
            _large_body = math.abs(_base_open - _base_close) > _max_height
            if _isSupply
                _bot := _large_body ? math.max(_base_open, _base_close - _max_height / 5) : _base_open
                _top := math.min(_top, _bot + _max_height)
            else
                _top := _large_body ? math.min(_base_open, _base_close + _max_height / 5) : _base_open
                _bot := math.max(_bot, _top - _max_height)
        _bot := math.round_to_mintick(_bot)
        _top := math.round_to_mintick(_top)
        _s1 = _isSupply ? _bot : _top
        // Price must depart on the intended side, with no distal closing breach AFTER the chosen
        // base (including an intervening tiny candle). A later reclaim never revives that origin.
        _unbreached = _isSupply ? s_after_close <= _top : d_after_close >= _bot
        _valid = _top > _bot and _unbreached and (_isSupply ? close < _bot : close > _top)
        if _top > _bot and not _unbreached
            // Preserve this rejected origin too; a later ATR expansion must not make it Fresh again.
            array.set(ds_registered_origin, _origin_slot, _s1_time)
        if _valid
            _zones_s1_active = _isSupply ? supply_zones_s1_active : demand_zones_s1_active
            _zones_s1 = _isSupply ? supply_zones_s1 : demand_zones_s1
            _zones_top = _isSupply ? supply_zones_top : demand_zones_top
            _zones_btm = _isSupply ? supply_zones_btm : demand_zones_btm
            _zones_state = _isSupply ? supply_zones_state : demand_zones_state
            _zones_box = _isSupply ? supply_zones_box : demand_zones_box
            _zones_time_all = _isSupply ? supply_zones_time_all : demand_zones_time_all
            _zones_s1_all = _isSupply ? supply_zones_s1_all : demand_zones_s1_all
            // The base and the run away from it are the formation, not a test: a zone is Fresh when it
            // registers and becomes Tested on the first touch after that
            array.set(ds_registered_origin, _origin_slot, _s1_time)
            array.unshift(_zones_time, _s1_time)
            array.unshift(_zones_s1, _s1)
            array.unshift(_zones_top, _top)
            array.unshift(_zones_btm, _bot)
            array.unshift(_zones_state, 0)
            array.unshift(_zones_s1_active, true)
            _trig = array.get(ds_inval_level, _origin_slot)
            array.set(ds_inval_level, _origin_slot, _isSupply ? (na(_trig) ? _top : math.min(_trig, _top)) : (na(_trig) ? _bot : math.max(_trig, _bot)))
            _sorted_idx = ds_sorted_index(_zones_s1_all, _s1)
            array.insert(_zones_s1_all, _sorted_idx, _s1)
            array.insert(_zones_time_all, _sorted_idx, _s1_time)
            _bord_col = _isSupply ? supply_bord_col : demand_bord_col
            _bg_col = _isSupply ? supply_bg_col : demand_bg_col
            box _new_box = na
            if _showZone
                _new_box := box.new(get_bar_time(_s1_time, 'minus', 1), _top, get_bar_time(_s1_time, 'add', 2), _bot, xloc=xloc.bar_time, border_color=_bord_col, border_width=1, bgcolor=_bg_col)
            // A placeholder keeps box/data indices aligned even when a side is hidden.
            array.unshift(_zones_box, _new_box)

            // Drop oldest tested/invalidated first, otherwise oldest fresh; remove every parallel field.
            while array.size(_zones_time) > ds_max_zones
                int _rm = array.size(_zones_time) - 1
                for i = array.size(_zones_time) - 1 to 0
                    if not array.get(_zones_s1_active, i)
                        _rm := i
                        break
                _all_idx = array.indexof(_zones_time_all, array.get(_zones_time, _rm))
                if _all_idx >= 0
                    array.remove(_zones_time_all, _all_idx)
                    array.remove(_zones_s1_all, _all_idx)
                remove_ds_alert_origin(_zone_type, array.get(_zones_time, _rm))
                array.remove(_zones_time, _rm)
                array.remove(_zones_s1_active, _rm)
                array.remove(_zones_s1, _rm)
                array.remove(_zones_top, _rm)
                array.remove(_zones_btm, _rm)
                array.remove(_zones_state, _rm)
                box.delete(array.remove(_zones_box, _rm))


add_ds_alert(_type, _time_unix, _origin) =>
    _origins = _type == 'S' ? supply_zones_alert_origin : demand_zones_alert_origin
    _sent = _type == 'S' ? supply_zones_alert_sent : demand_zones_alert_sent
    array.unshift(_origins, _origin)
    array.unshift(_sent, _time_unix)

remove_ds_alerts(_type, _time_unix) =>
    _origins = _type == 'S' ? supply_zones_alert_origin : demand_zones_alert_origin
    _sent = _type == 'S' ? supply_zones_alert_sent : demand_zones_alert_sent
    if array.size(_origins) > 0
        for i = array.size(_origins) - 1 to 0
            if _time_unix - array.get(_sent, i) >= ds_alert_mins_no_repeat * 60 * 1000
                array.remove(_origins, i)
                array.remove(_sent, i)

check_repeat_alert(_type, _origin) =>
    _origins = _type == 'S' ? supply_zones_alert_origin : demand_zones_alert_origin
    _repeatAlert = array.includes(_origins, _origin)
    _repeatAlert

get_ds_zone_info(_zone_type, _s1, _s1_time) =>
    _info = _zone_type == 'S' ? 'Supply Zone ' : 'Demand Zone '
    _info += str.tostring(_s1) + '\n'
    _times = _zone_type == 'S' ? supply_zones_time : demand_zones_time
    _states = _zone_type == 'S' ? supply_zones_state : demand_zones_state
    _tops = _zone_type == 'S' ? supply_zones_top : demand_zones_top
    _btms = _zone_type == 'S' ? supply_zones_btm : demand_zones_btm
    _idx = array.indexof(_times, _s1_time)
    if _idx >= 0
        _state = array.get(_states, _idx)
        _info += (_state == 0 ? 'Fresh' : _state == 1 ? 'Tested' : 'Invalidated') + '\n'
        _info += 'Range: ' + str.tostring(array.get(_btms, _idx)) + ' - ' + str.tostring(array.get(_tops, _idx)) + '\n'
    _info += 'from UTC'
    _info += ds_hours_offset > 0 ? '+' + str.tostring(ds_hours_offset) : ds_hours_offset < 0 ? str.tostring(ds_hours_offset) : ''
    _info += str.format(': {0,date,yyyy/MM/dd HH:mm}', _s1_time + (60 * 60 * 1000 * ds_hours_offset)) + '\n'
    _info

alert_ds(_doRaw, _zone_type, _s1, _s1_time, _alert_type) =>
    _repeatAlert = false
    _event_time = barstate.isrealtime ? timenow : nz(time_close, time)
    // Respect the Demand / Supply alert switches
    _do = _doRaw and (_zone_type == 'S' ? dsAlertSupply : dsAlertDemand)

    // Hit only happens once because the zone is deactivated
    // Near can happen many times, so do not repeat within time limit
    if _do and _alert_type == 'N' and ds_alert_mins_no_repeat > 0
        // Actual elapsed time on a live bar; bar-open time cannot enforce a minute cooldown on HTFs.
        remove_ds_alerts(_zone_type, _event_time)
        _repeatAlert := check_repeat_alert(_zone_type, _s1_time)
        if not _repeatAlert
            add_ds_alert(_zone_type, _event_time, _s1_time)

    // The queue is only sent on realtime bars; cooldown bookkeeping above still runs on every bar
    if _do and not _repeatAlert and barstate.isrealtime
        _msg = _alert_type == 'H' ? 'Zone hit' : 'Near zone'
        _msg += '\n' + get_ds_zone_info(_zone_type, _s1, _s1_time)
        array.push(ds_alert_keys, '|' + _alert_type + _zone_type + str.tostring(_s1_time) + '|')
        array.push(ds_alert_msgs, _msg)

deactivate_ds_box(_box, _invalid) =>
    if not na(_box)
        box.set_bgcolor(_box, TRANSP_CSS)
        box.set_border_style(_box, _invalid ? line.style_dashed : line.style_dotted)
        if _invalid
            box.set_border_color(_box, color.new(color.gray, 40))

deactivate_ds_limited(_do, _zone_type, _s1, _s1_time) =>
    if _do
        _zones_time = _zone_type == 'S' ? supply_zones_time : demand_zones_time
        _zones_s1 = _zone_type == 'S' ? supply_zones_s1 : demand_zones_s1
        _zones_s1_active = _zone_type == 'S' ? supply_zones_s1_active : demand_zones_s1_active
        _zones_top = _zone_type == 'S' ? supply_zones_top : demand_zones_top
        _zones_btm = _zone_type == 'S' ? supply_zones_btm : demand_zones_btm
        _zones_state = _zone_type == 'S' ? supply_zones_state : demand_zones_state
        _zones_box = _zone_type == 'S' ? supply_zones_box : demand_zones_box
        _index = array.indexof(_zones_time, _s1_time)
        if _index >= 0
            _invalid = barstate.isconfirmed and (_zone_type == 'S' ? close > array.get(_zones_top, _index) : close < array.get(_zones_btm, _index))
            array.set(_zones_s1_active, _index, false)
            array.set(_zones_state, _index, _invalid ? 2 : 1)
            remove_ds_alert_origin(_zone_type, _s1_time)
            deactivate_ds_box(array.get(_zones_box, _index), _invalid)

// A touch is a test, never automatically an invalidation. Tested zones stay tracked until a
// confirmed distal close-through; they remain outside the one-touch Fresh alert registry.
invalidate_ds_zones(_zone_type) =>
    _times = _zone_type == 'S' ? supply_zones_time : demand_zones_time
    _states = _zone_type == 'S' ? supply_zones_state : demand_zones_state
    _tops = _zone_type == 'S' ? supply_zones_top : demand_zones_top
    _btms = _zone_type == 'S' ? supply_zones_btm : demand_zones_btm
    _active = _zone_type == 'S' ? supply_zones_s1_active : demand_zones_s1_active
    _boxes = _zone_type == 'S' ? supply_zones_box : demand_zones_box
    _all_times = _zone_type == 'S' ? supply_zones_time_all : demand_zones_time_all
    _all_levels = _zone_type == 'S' ? supply_zones_s1_all : demand_zones_s1_all
    _slot = _zone_type == 'S' ? 0 : 1
    _trig = array.get(ds_inval_level, _slot)
    // No zone can be invalidated unless the close is beyond the trigger (most bars skip the scan)
    if barstate.isconfirmed and array.size(_times) > 0 and not na(_trig) and (_zone_type == 'S' ? close > _trig : close < _trig)
        float _next = na
        for i = 0 to array.size(_times) - 1
            if array.get(_states, i) != 2
                if _zone_type == 'S' ? close > array.get(_tops, i) : close < array.get(_btms, i)
                    array.set(_states, i, 2)
                    array.set(_active, i, false)
                    _all_idx = array.indexof(_all_times, array.get(_times, i))
                    if _all_idx >= 0
                        array.remove(_all_times, _all_idx)
                        array.remove(_all_levels, _all_idx)
                    remove_ds_alert_origin(_zone_type, array.get(_times, i))
                    deactivate_ds_box(array.get(_boxes, i), true)
                else
                    _next := _zone_type == 'S' ? (na(_next) ? array.get(_tops, i) : math.min(_next, array.get(_tops, i))) : (na(_next) ? array.get(_btms, i) : math.max(_next, array.get(_btms, i)))
        array.set(ds_inval_level, _slot, _next)

check_ds_zone_hit() =>
    // Active zones are sorted by price: every hit zone sits at the near end of its array,
    // so we stop at the first zone that is not hit / not near (no zone can be skipped)

    // Demand: nearest zone is the last element
    while array.size(demand_zones_s1_all) > 0
        _last = array.size(demand_zones_s1_all) - 1
        _s1 = array.get(demand_zones_s1_all, _last)
        if low > _s1
            break
        _s1_time = array.get(demand_zones_time_all, _last)
        array.pop(demand_zones_s1_all)
        array.pop(demand_zones_time_all)
        deactivate_ds_limited(true, 'D', _s1, _s1_time)
        alert_ds(true, 'D', _s1, _s1_time, 'H')

    if array.size(demand_zones_s1_all) > 0
        for i = array.size(demand_zones_s1_all) - 1 to 0
            _s1 = array.get(demand_zones_s1_all, i)
            if low > get_amount_by_pc(_s1, ds_near_pc_eff, 'add')
                break
            alert_ds(true, 'D', _s1, array.get(demand_zones_time_all, i), 'N')

    // Supply: nearest zone is the first element
    while array.size(supply_zones_s1_all) > 0
        _s1 = array.get(supply_zones_s1_all, 0)
        if high < _s1
            break
        _s1_time = array.get(supply_zones_time_all, 0)
        array.shift(supply_zones_s1_all)
        array.shift(supply_zones_time_all)
        deactivate_ds_limited(true, 'S', _s1, _s1_time)
        alert_ds(true, 'S', _s1, _s1_time, 'H')

    if array.size(supply_zones_s1_all) > 0
        for i = 0 to array.size(supply_zones_s1_all) - 1
            _s1 = array.get(supply_zones_s1_all, i)
            if high < get_amount_by_pc(_s1, ds_near_pc_eff, 'minus')
                break
            alert_ds(true, 'S', _s1, array.get(supply_zones_time_all, i), 'N')

add_ds_lbl_tooltip(_lbl, _zone_type, _s1, _s1_time) =>
    _info = get_ds_zone_info(_zone_type, _s1, _s1_time)
    label.set_tooltip(_lbl, _info)

// Draw one nearby-zone line + price label
draw_ds_line(_lines, _lbls, _zone_type, _s1, _s1_time, _col, _x_offset) =>
    array.push(_lines, line.new(get_bar_time(_s1_time, 'add', 2), _s1, get_bar_time(time, 'add', 1), _s1
      , xloc=xloc.bar_time, color=_col, style=line.style_solid))
    _lbl = label.new(bar_index + 4 + _x_offset, _s1, str.tostring(_s1)
      , color=_col, textcolor=priceNumberColor, style=label.style_label_left)
    add_ds_lbl_tooltip(_lbl, _zone_type, _s1, _s1_time)
    array.push(_lbls, _lbl)

draw_nearby_ds_s1() =>
    // Pure drawing, rebuilt on the last bar only: always the newest drawings, so the
    // drawing-limit cleanup never removes them
    if barstate.islast
        for _l in demand_zones_s1_line
            line.delete(_l)
        for _l in supply_zones_s1_line
            line.delete(_l)
        for _l in demand_zones_s1_line_price
            label.delete(_l)
        for _l in supply_zones_s1_line_price
            label.delete(_l)
        array.clear(demand_zones_s1_line)
        array.clear(supply_zones_s1_line)
        array.clear(demand_zones_s1_line_price)
        array.clear(supply_zones_s1_line_price)

        _bars_out = 25

        // Demand: walk down from the nearest active zone (end of the sorted array)
        if showDemandZone and array.size(demand_zones_s1_all) > 0
            float _s1_prev = na
            _extra_bars = 0
            for i = array.size(demand_zones_s1_all) - 1 to 0
                _s1 = array.get(demand_zones_s1_all, i)
                // Zones outside the SMC drawing range end the walk too (every further zone is farther out)
                if array.size(demand_zones_s1_line) == ds_line_max or get_pc_diff_abs(close, _s1) > ds_line_pc_eff or not aoi_ok(_s1, _s1)
                    break
                // Stagger labels of zones that sit close together
                _diff_to_prev = not na(_s1_prev) ? get_pc_diff_abs(_s1_prev, _s1) : na
                _extra_bars := _extra_bars > 0 ? 0 : _diff_to_prev < ds_stagger_pc ? _bars_out : 0
                draw_ds_line(demand_zones_s1_line, demand_zones_s1_line_price, 'D', _s1, array.get(demand_zones_time_all, i), demand_bord_col, _extra_bars)
                _s1_prev := _s1

        // Supply: walk up from the nearest active zone (start of the sorted array)
        if showSupplyZone and array.size(supply_zones_s1_all) > 0
            float _s1_prev = na
            _extra_bars = 0
            for i = 0 to array.size(supply_zones_s1_all) - 1
                _s1 = array.get(supply_zones_s1_all, i)
                if array.size(supply_zones_s1_line) == ds_line_max or get_pc_diff_abs(close, _s1) > ds_line_pc_eff or not aoi_ok(_s1, _s1)
                    break
                _diff_to_prev = not na(_s1_prev) ? get_pc_diff_abs(_s1_prev, _s1) : na
                _extra_bars := _extra_bars > 0 ? 0 : _diff_to_prev < ds_stagger_pc ? _bars_out : 0
                draw_ds_line(supply_zones_s1_line, supply_zones_s1_line_price, 'S', _s1, array.get(supply_zones_time_all, i), supply_bord_col, _extra_bars)
                _s1_prev := _s1

// ================================== //
// ---->  Demand & Supply Calc  <---- //
// ================================== //

check_ds_zone_hit()
invalidate_ds_zones('D')
invalidate_ds_zones('S')

// Send one hit/zone/bar or one near/zone/cooldown cycle. Near cooldowns themselves are varip,
// so an expired cooldown can legitimately alert again inside an HTF bar without a growing key log.
// When cooldowns are disabled, static per-bar keys retain the original one-near-per-bar behavior.
varip string ds_sent_keys = ''
varip int ds_sent_bar = na
// Alerts only fire in realtime, so the queue is skipped on historical bars
if barstate.isrealtime and array.size(ds_alert_keys) > 0
    if na(ds_sent_bar) or ds_sent_bar != bar_index
        ds_sent_keys := ''
        ds_sent_bar := bar_index
    for i = 0 to array.size(ds_alert_keys) - 1
        _key = array.get(ds_alert_keys, i)
        _near_cycle = ds_alert_mins_no_repeat > 0 and str.startswith(_key, '|N')
        if _near_cycle or not str.contains(ds_sent_keys, _key)
            if not _near_cycle
                ds_sent_keys += _key
            alert(array.get(ds_alert_msgs, i), alert.freq_all)

add_ds_zone('D')
add_ds_zone('S')

draw_nearby_ds_s1()
/////


import              Bjorgum/BjCandlePatterns/2 as bj

// ================================== //
// ------------> Tips <-------------- //
// ================================== //

leftTip         =   "Look left for swing high/low in x number of bars to form pivot. The higher the number, the higher the script looks to the left for the highest/lowest point before drawing pivot"
rightTip        =   "Look right for swing high/low in x number of bars to form pivot. The higher the number, the higher the script looks to the right for the highest/lowest point before drawing pivot"
nPivTip         =   "This sets the array size, or the number of pivots to track at a time (x highs, and x number of lows)"
atrLenTip       =   "Number of bars to average. ATR is used to standardize zone width between assets and timeframes"
multTip         =   "ATR multiplier to set zone width. Default is half of one ATR from box bottom to box top"
perTip          =   "Max zone size as a percent of price. Some assets can be too volatile at low prices creating an unreasonably sized zone"
maxTip          =   "Number of boxes for candlestick patterns to track historically. Note: the higher the number the less pivot zones will be tracked when looking back in time due to the limitation on the number of box elements allowed at once"
futTip          =   "Number of bars to offset labels for price levels"
srcTip          =   "Source input for pivots. Default uses actual candle bodies. HA uses averaged Heikin-Ashi bodies; High/Low uses actual candle wicks. These are pivot Support/Resistance zones, separate from SMC order blocks and Demand/Supply"
alignZonesTip   =   "Aligns recurring zones who's edges overlap an existing zone creating a zone that ages in time and intensifies visually"
extendTip       =   "Extends current zones right"
lLabTip         =   "Show labels for price levels extended off Key Levels"

dhighsTip       =   "Disabling will prevent highs from being tracked"
dlowsTip        =   "Disabling will prevent lows from being tracked"
detectBOTip     =   "Show points that price action breaks above all pivots. An arrow from below is displayed"
detectBDTip     =   "Show points that price action breaks below all pivots. An arrow from above is displayed"
breakUpTip      =   "Show points that price action breaks above resistance. An arrow from below is displayed"
breakDnTip      =   "Show points that price action breaks below support. An arrow from above is displayed"
falseBullTip    =   "Show points that price action initially breaks below support before reversing. False moves can lead to fast moves in the opposite direction (bear trap). A large arrow from below is displayed"
falseBearTip    =   "Show points that price action initially breaks above resistance before reversing. False moves can lead to fast moves in the opposite direction (bull trap). A large arrow from above is displayed"
supPushTip      =   "Show up candles that are detected within a support zone. Can show points support is being respected. A triangle from below is displayed"
resPushTip      =   "Show down candles that are detected within a resistance zone. Can show points resistance is being respected. A triangle from above is displayed"
curlTip         =   "Show Bjorgum TSI 'curl' when candles are detected in the range of a key zone. Can show momentum shift at Key Levels. (Correlates to Bjorgum TSI indicator)"

repaintTip      =   "Wait for candles end before detecting patterns. False will show potential patterns forming before they are confirmed."
labelsTip       =   "Show a label for detected candle patterns"
sBoxTip         =   "Show a box around detected candle patterns"
dTip            =   "Detect Doji candle patterns"
beTip           =   "Detect Engulfing patterns"
hsTip           =   "Detect Hammers and Shooting Star patterns"
dgTip           =   "Detect Dragonfly Doji and Gravestone Doji patterns"
twTip           =   "Detect Tweezer Top and Tweezer Bottom patterns"
stTip           =   "Detect Spinning Top patterns"
pcTip           =   "Detect Piercing and Dark Cloud Cover patterns"
bhTip           =   "Detect Harami candle patterns"
lsTip           =   "Detect Long Upper Shadow and Long Lower Shadow patterns"

ecWickTip       =   "Determines if engulfing candles must engulf the wick or just the body of the preceding candle"
colorMatchTip   =   "Determines if hammers must be up candles and shooting stars must be down candles"
closeHalfTip    =   "Determines if Tweezer patterns must close beyond the half way point of the preceding candle"
atrMaxTip       =   "Maximum size of setup candles (as a multiplier of the current ATR)"
rejectWickTip   =   "The maximum wick size as a percentage of body size allowable for a rejection wick on the resolution candle of the pattern. 0 disables the filter"
hammerFibTip    =   "The relationship of body to candle size for hammers and stars. (ie. body is 33% of total candle size)."
hsShadowPercTip =   "The maximum allowable opposing wick size as a percent of body size (ex. top wick for a hammer pattern etc.)"
hammerSizeTip   =   "The minimum size of hammers, stars, or long shadows as a multiplier of ATR. (To filter out tiny setups)"
dojiSizeTip     =   "The relationship of body to candle size (ie. body is 5% of total candle size)."
dojiWickSizeTip =   "Maximum wick size comparative to the opposite wick. (eg. 2 = bottom wick must be less than or equal to 2x the top wick)."
luRatioTip      =   "A relationship of the upper wick to the overall candle size expressed as a percent."

lookbackTip     =   "Maximum confirmed bars from a close beyond one pivot zone to a close reclaiming its opposite edge. Break and reclaim must refer to the same unchanged zone; wick-only sweeps are not included"
swingTip        =   "Swing detection is used to filter signals on breakout type signals. A higher number will mean more significant points, but less of them"
reflectTip      =   "Filter to ensure a setup is a significant swing point. Look back this far (maximum 250 bars)"
offsetTip       =   "Candle pattern high/low rank from the significant extreme. 0 requires the highest/lowest; 1 accepts the next rank. Values above Significant High/Low are clamped to that length"

bullPivotTip    =   "Color of bullish Key Levels\n(border, background)"
bearPivotTip    =   "Color of bearish Key Levels\n(border, background)"
breakoutTip     =   "Color of breakout arrows\n(bull, bear,)"
SnRTip          =   "Color of triangles for broken support or resistance\n(bull, bear)"
falseBreakTip   =   "Color of arrows for false breaks\n(bull, bear, arrow max height in pixels)"
moveTip         =   "Color of triangles for candles that are detected within zones\n(bull, bear)"
patTip          =   "Color of boxes that wrap candestick patterns\nBackgrounds: (bull, neutral, bear)\nBorders: (bull, neutral, bear)"
labTip          =   "Color of labels that mark candestick patterns\nText: (bull, neutral, bear)\nLabels: (bull, neutral, bear)"
stratTip        =   "TSI speed control presets. Both speeds correlate to the Bjorgum TSI indicator"

// ================================== //
// ---------> User Input <----------- //
// ================================== //

left            =   input.int       (20     ,   "Look Left"                     ,   group= "Zones"                , tooltip= leftTip , minval=1, maxval=250)
right           =   input.int       (10     ,   "Look Right"                    ,   group= "Zones"                , tooltip= rightTip , minval=1, maxval=250)
nPiv            =   input.int       (2      ,   "Number of Pivots"              ,   group= "Zones"                , tooltip= nPivTip            ,   minval = 1 , maxval=10)
atrLen          =   input.int       (30     ,   "ATR Length"                    ,   group= "Zones"                , tooltip= atrLenTip , minval=1, maxval=250)
mult            =   input.float     (0.5    ,   "Zone Width (ATR)"              ,   group= "Zones"                , tooltip= multTip            ,   step   = 0.1 , minval=0.1, maxval=10)
per             =   input.float     (5      ,   "Max Zone Percent"              ,   group= "Zones"                , tooltip= perTip , minval=0.01, maxval=20)
max             =   input.int     (10     ,   "Max Boxes for Patterns"        ,   group= "Zones"                , tooltip= maxTip , minval=0, maxval=10)
fut             =   input.int       (30     ,   "Offset For Labels"             ,   group= "Zones"                , tooltip= futTip , minval=0, maxval=250)
src             =   input.string    ("High/Low Body", "Source For Pivots"             ,   group= "Zones"                , tooltip= srcTip             ,   options= ["HA", "High/Low Body", "High/Low"])
alignZones      =   input.bool      (true   ,   "Align Zones"                   ,   group= "Zones"                , tooltip= alignZonesTip      )
extend          =   input.bool      (false  ,   "Extend Right"                  ,   group= "Zones"                , tooltip= extendTip          )
lLab            =   input.bool      (true   ,   "Show Level Labels"             ,   group= "Zones"                , tooltip= lLabTip            )

dhighs          =   input.bool      (true   ,   "Detect Pivot Highs"            ,   group= "Detection"            , tooltip= dhighsTip          )
dlows           =   input.bool      (true   ,   "Detect Pivot Lows"             ,   group= "Detection"            , tooltip= dlowsTip           )
detectBO        =   input.bool      (true   ,   "Detect Breakout"               ,   group= "Detection"            , tooltip= detectBOTip        )
detectBD        =   input.bool      (true   ,   "Detect Breakdown"              ,   group= "Detection"            , tooltip= detectBDTip        )
breakUp         =   input.bool      (true   ,   "Detect Resistance Break"       ,   group= "Detection"            , tooltip= breakUpTip         )
breakDn         =   input.bool      (true   ,   "Detect Support Break"          ,   group= "Detection"            , tooltip= breakDnTip         )
falseBull       =   input.bool      (true   ,   "Detect False Breakdown"        ,   group= "Detection"            , tooltip= falseBullTip       )
falseBear       =   input.bool      (true   ,   "Detect False Breakup"          ,   group= "Detection"            , tooltip= falseBearTip       )
supPush         =   input.bool      (true   ,   "Detect Moves Off Support"      ,   group= "Detection"            , tooltip= supPushTip         )
resPush         =   input.bool      (true   ,   "Detect Moves Off Resistance"   ,   group= "Detection"            , tooltip= resPushTip         )
curl            =   input.bool      (true   ,   "Detect TSI Curl"               ,   group= "Detection"            , tooltip= curlTip            )

repaint         =   input.bool      (true   ,   "Wait For Confirmed Bar"        ,   group= "Candle Patterns"      , tooltip= repaintTip         )
labels          =   input.bool      (true   ,   "Show Label"                    ,   group= "Candle Patterns"      , tooltip= labelsTip          )
sBox            =   input.bool      (true   ,   "Show Boxes Around Patterns"    ,   group= "Candle Patterns"      , tooltip= sBoxTip            )
d_              =   input.bool      (true   ,   "Detect Doji"                   ,   group= "Candle Patterns"      , tooltip= dTip               )
be_             =   input.bool      (true   ,   "Detect Engulfing"              ,   group= "Candle Patterns"      , tooltip= beTip              )
hs_             =   input.bool      (true   ,   "Detect Hammers and Stars"      ,   group= "Candle Patterns"      , tooltip= hsTip              )
dg_             =   input.bool      (true   ,   "Detect Dragons and Graves"     ,   group= "Candle Patterns"      , tooltip= dgTip              )
tw_             =   input.bool      (true   ,   "Detect Tweezers"               ,   group= "Candle Patterns"      , tooltip= twTip              )
st_             =   input.bool      (true   ,   "Detect Spinning Top"           ,   group= "Candle Patterns"      , tooltip= stTip              )
pc_             =   input.bool      (true   ,   "Detect Piercing and Clouds"    ,   group= "Candle Patterns"      , tooltip= pcTip              )
bh_             =   input.bool      (true   ,   "Detect Harami"                 ,   group= "Candle Patterns"      , tooltip= bhTip              )
ls_             =   input.bool      (true   ,   "Detect Long Shadows"           ,   group= "Candle Patterns"      , tooltip= lsTip              )

alertMode       =   input.string    (alert.freq_once_per_bar_close              ,   "Alerts Mode"                 , group  = "Alert Frequency"  ,   options= [alert.freq_once_per_bar, alert.freq_once_per_bar_close])

ecWick          =   input.bool      (false  ,   "Engulfing Must Engulf Wick"    ,   group= "Candle Filters"       , tooltip= ecWickTip          )
colorMatch      =   input.bool      (false  ,   "H&S Must Match Color"          ,   group= "Candle Filters"       , tooltip= colorMatchTip      )
closeHalf       =   input.bool      (false  ,   "Tweezer Close Over Half"       ,   group= "Candle Filters"       , tooltip= closeHalfTip       )
atrMax          =   input.float     (0.0    ,   "Max Candle Size (× ATR)"       ,   group= "Candle Filters"       , tooltip= atrMaxTip          ,   step= 0.1 , minval=0, maxval=20)
rejectWickMax   =   input.float     (0.0    ,   "[EC] Max Reject Wick Size"     ,   group= "Candle Filters"       , tooltip= rejectWickTip      ,   step= 1 , minval=0, maxval=1000)
hammerFib       =   input.float     (33     ,   "[HS] H&S Ratio (%)"            ,   group= "Candle Filters"       , tooltip= hammerFibTip       ,   step= 1 , minval=1, maxval=50)
hsShadowPerc    =   input.float     (5      ,   "[HS] H&S Opposing Shadow (%)"  ,   group= "Candle Filters"       , tooltip= hsShadowPercTip    ,   step= 1 , minval=0, maxval=100)
hammerSize      =   input.float     (0.1    ,   "[HS] H&S Min Size (× ATR)"     ,   group= "Candle Filters"       , tooltip= hammerSizeTip      ,   step= 0.1 , minval=0, maxval=10)
dojiSize        =   input.float     (5      ,   "[DJ] Doji Size (%)"            ,   group= "Candle Filters"       , tooltip= dojiSizeTip        ,   step= 1 , minval=0, maxval=50)
dojiWickSize    =   input.float     (2      ,   "[DJ] Max Doji Wick Size"       ,   group= "Candle Filters"       , tooltip= dojiWickSizeTip    ,   step= 1 , minval=1, maxval=10)
luRatio         =   input.float     (75     ,   "[LS] Long Shadow (%)"          ,   group= "Candle Filters"       , tooltip= luRatioTip         ,   step= 1 , minval=50, maxval=100)

lookback        =   input.int       (2      ,   "Lookback For Breaks"           ,   group= "Lookback"             , tooltip= lookbackTip , minval=1, maxval=50)
swing           =   input.int       (5      ,   "swing High/Low"                ,   group= "Lookback"             , tooltip= swingTip , minval=1, maxval=250)
reflect         =   input.int       (10     ,   "Significant High/Low"          ,   group= "Lookback"             , tooltip= reflectTip , minval=1, maxval=250)
offset          =   input.int       (1      ,   "Consider Bar From High/Low"    ,   group= "Lookback"             , tooltip= offsetTip , minval=0, maxval=250)

bullBorder      =   input.color     (color.new(#7ec4fd, 0), "", inline= "0"  ,   group= "Pivot Color"                                        )
bullBgCol       =   input.color     (color.new  (#64b5f6, 95), "", inline= "0"  ,   group= "Pivot Color"          , tooltip= bullPivotTip       )
bearBorder      =   input.color     (color.new(#f7ea7e, 0), "", inline= "1"  ,   group= "Pivot Color"                                        )
bearBgCol       =   input.color     (color.new  (#ffeb3b, 95), "", inline= "1"  ,   group= "Pivot Color"          , tooltip= bearPivotTip       )

upCol           =   input.color     (color.new  (#ff6d00, 25), "", inline= "2"  ,   group= "Breakout Color"                                     )
dnCol           =   input.color     (color.new  (#ff00ff, 25), "", inline= "2"  ,   group= "Breakout Color"       , tooltip= breakoutTip        )

supCol          =   input.color     (color.new  (#17ff00, 25), "", inline= "3"  ,   group= "S&R Break Color"                                    )
resCol          =   input.color     (color.new  (#ff0000, 25), "", inline= "3"  ,   group= "S&R Break Color"      , tooltip= SnRTip             )

fBull           =   input.color     (color.new  (#17ff00, 25), "", inline= "4"  ,   group= "False Break Color"                                  )
fBear           =   input.color     (color.new  (#ff0000, 25), "", inline= "4"  ,   group= "False Break Color"                                  )
arrowMax        =   input.int       (75                      , "", inline= "4"  ,   group= "False Break Color"    , tooltip= falseBreakTip , minval=1, maxval=300)

moveBullCol     =   input.color     (color.new(#957af7, 1), "", inline= "5"  ,   group= "Moves From S&R Color"                               )
moveBearCol     =   input.color     (color.new(#f8eb79, 1), "", inline= "5"  ,   group= "Moves From S&R Color" , tooltip= moveTip            )

curlBullCol     =   input.color     (color.new  (#17ff00, 40), "", inline= "6"  ,   group= "Momentum Curl Color"                                )
curlBearCol     =   input.color     (color.new  (#f3ff00, 40), "", inline= "6"  ,   group= "Momentum Curl Color"  , tooltip= curlTip            )

patBullBg       =   input.color     (color.new  (#17ff00, 90), "", inline= "7"  ,   group= "Pattern Box Color"                                  )
patNeutBg       =   input.color     (color.new  (#b2b5be, 90), "", inline= "7"  ,   group= "Pattern Box Color"                                  )
patBearBg       =   input.color     (color.new  (#ff0000, 90), "", inline= "7"  ,   group= "Pattern Box Color"                                  )
patBullBo       =   input.color     (color.new  (#17ff00, 80), "", inline= "8"  ,   group= "Pattern Box Color"                                  )
patNeutBo       =   input.color     (color.new  (#b2b5be, 80), "", inline= "8"  ,   group= "Pattern Box Color"                                  )
patBearBo       =   input.color     (color.new  (#ff0000, 80), "", inline= "8"  ,   group= "Pattern Box Color"    , tooltip= patTip             )

textBullCol     =   input.color     (color.new  (#17ff00,  0), "", inline= "9"  ,   group= "Label Color (Text/Bg)"                              )
textNeutCol     =   input.color     (color.new  (#b2b5be,  0), "", inline= "9"  ,   group= "Label Color (Text/Bg)"                              )
textBearCol     =   input.color     (color.new  (#ff0000,  0), "", inline= "9"  ,   group= "Label Color (Text/Bg)"                              )
labBullCol      =   input.color     (color.new  (#17ff00, 80), "", inline= "10" ,   group= "Label Color (Text/Bg)"                              )
labNeutCol      =   input.color     (color.new  (#b2b5be, 80), "", inline= "10" ,   group= "Label Color (Text/Bg)"                              )
labBearCol      =   input.color     (color.new  (#ff0000, 80), "", inline= "10" ,   group= "Label Color (Text/Bg)", tooltip= labTip             )

strat           =   input.string    ("Fast" ,   "Select a Speed"                ,   group= "TSI Speed Control"    , tooltip= stratTip           ,   options= ["Fast", "Slow"])

longf           =   input.int       (25     ,   "Long Length"                   ,   group= "TSI Fast Settings" , minval=1, maxval=250)
shortf          =   input.int       (5      ,   "Short Length"                  ,   group= "TSI Fast Settings" , minval=1, maxval=250)
signalf         =   input.int       (14     ,   "Signal Length"                 ,   group= "TSI Fast Settings" , minval=1, maxval=250)

longs           =   input.int       (25     ,   "Long Length"                   ,   group= "TSI Slow Settings" , minval=1, maxval=250)
shorts          =   input.int       (13     ,   "Short Length"                  ,   group= "TSI Slow Settings" , minval=1, maxval=250)
signals         =   input.int       (13     ,   "Signal Length"                 ,   group= "TSI Slow Settings" , minval=1, maxval=250)

// Every pivot zone has a stable logical identity independent of its current drawing/role.
// A changed geometry or new zone cannot inherit another zone's pending break.
type PivotZoneState
    int id
    int born
    float top
    float btm
    int breakBar
    int breakDir
    float breakTop
    float breakBtm

// ================================== //
// -----> Immutable Constants <------ //
// ================================== //

sync            =   bar_index
labUp           =   label.style_label_up
labDn           =   label.style_label_down
confirmed       =   barstate.isconfirmed
extrap          =   extend ?        extend.right  : extend.none

var pivotHigh   =   array.new_box   (nPiv)
var pivotLows   =   array.new_box   (nPiv)
var highBull    =   array.new_bool  (nPiv)
var lowsBull    =   array.new_bool  (nPiv)
var highState   =   array.new<PivotZoneState>(nPiv)
var lowState    =   array.new<PivotZoneState>(nPiv)
var int pivotNextID = 0
// At most 20 active + 50 retired + 10 pattern boxes = 80 boxes for this module.
pivotAlertMessages = array.new_string(0)
var boxes       =   array.new_box   ()
var pivotHist   =   array.new_box   ()      // retired zone boxes kept as history (bounded)
var histRight   =   array.new_int   ()      // their real right edge (bar index), parallel to pivotHist
var histBull    =   array.new_bool  ()      // their direction, parallel to pivotHist

haSrc           =   src    ==       "HA"
hiLoSrc         =   src    ==       "High/Low"
tsifast         =   strat  ==       "Fast"
tsislow         =   strat  ==       "Slow"

// ================================== //
// ---> Functional Declarations <---- //
// ================================== //


//Zone ATR from the "ATR Length" input (the script previously fell back to the SMC ATR(200))
zoneAtr         =   ta.atr              (atrLen)

perMax          =   close*          0.02
min             =   math.min        (perMax, zoneAtr*0.3)

_haBody()       =>
    haClose     =   (open + high  +  low  + close)    / 4
    haOpen      =   float(na)
    haOpen      :=  na(haOpen[1]) ? (open + close)    / 2 :
                   (nz(haOpen[1]) + nz(haClose[1]))   / 2

    [haOpen, haClose]

_extend(_x) =>
    for i = 0 to               array.size       (_x)-1
        box.set_right          (array.get       (_x, i), sync)

//Returns the element pushed out of the array (na when none)
_arrayLoad(_x, _max, _val) =>
    array.unshift                               (_x,   _val)
    bool _out   =   na
    if  array.size                              (_x) > _max
        _out    :=  array.pop                   (_x)
    _out

//Keep the last 50 retired zone boxes as history and delete older ones,
//so pivot history can't push the drawing count past the 500 box limit.
//Their right edge and direction are kept for the display filter (_histDisplay)
_retire(_b, _isBull) =>
    array.unshift                               (pivotHist, _b)
    array.unshift                               (histRight, na(_b) ? int(na) : box.get_right(_b))
    array.unshift                               (histBull,  _isBull)
    if  array.size                              (pivotHist) > 50
        box.delete(array.pop                    (pivotHist))
        array.pop                               (histRight)
        array.pop                               (histBull)

//_wasBull: direction of the zone pushed out (from _arrayLoad on the parallel direction array)
_arrayBox(_x, _max, _val, _wasBull) =>
    array.unshift                               (_x,   _val)
    if       array.size                         (_x) > _max
        _b = array.pop                          (_x)
        if extend
            box.set_extend                      (_b, extend.none)
        _retire                                 (_b, _wasBull)

_arrayWrap(_x, _max, _val) =>
    array.unshift                               (_x,   _val)
    if  array.size                              (_x) > _max
        box.delete(array.pop                    (_x))

_delLab(_x)     =>
    if array.size(_x) > 0
        label.delete           (array.pop       (_x))

_delLine(_x)    =>
    if array.size(_x) > 0
        line.delete            (array.pop       (_x))

_delLevels(_x, _y)  =>
    for i = 0 to array.size                     (_x)-1
        _delLab                                 (_x)
        _delLine                                (_y)

_box(_x1, _t, _r, _b, _boCol, _bgCol, _e) =>
    box.new(                   _x1, _t, _r, _b  ,
     xloc        =             xloc.bar_index   ,
     extend      =             _e               ,
     border_color=             _boCol           ,
     bgcolor     =             _bgCol           )

//Pattern boxes wrap 1 or 2 candles: their high/low are computed once per bar instead of in all 18 calls
wrapHigh2       =   ta.highest          (high,          2)
wrapLow2        =   ta.lowest           (low,           2)

_wrap(_cond, _x, _bb, _bc, _bgc) =>
    if  _cond
        _t       =             (_bb == 1 ?      high : wrapHigh2) + min
        _b       =             (_bb == 1 ?      low  : wrapLow2)  - min
        _arrayWrap            (_x, max, _box    (bar_index - _bb, _t, bar_index + 1, _b, _bc, _bgc, extend.none))

_getBox(_x,_i)   =>
    _box         =             array.get        (_x,_i)
    _t           =             box.get_top      (_box)
    _b           =             box.get_bottom   (_box)
    [_t, _b]

_align(_x,_y)    =>
    for i = 0 to               array.size       (_x) -1
        [_T, _B] =             _getBox          (_y, 0)
        [_t, _b] =             _getBox          (_x, i)
        if _T > _b and         _T < _t or
           _B < _t and         _B > _b or
           _T > _t and         _B < _b or
           _B > _b and         _T < _t
            box.set_top        (array.get       (_y, 0), _t)
            box.set_bottom     (array.get       (_y, 0), _b)

_stateLoad(array<PivotZoneState> _states, PivotZoneState _state) =>
    array.unshift(_states, _state)
    if array.size(_states) > nPiv
        array.pop(_states)

_pivotIDText(PivotZoneState _state) =>
    'Pivot S/R #' + str.tostring(_state.id) + ' [' + str.tostring(_state.btm, format.mintick) + '–' + str.tostring(_state.top, format.mintick) + ']'

// Return actual per-zone close-crossing events, never changes in an aggregate counter.
// The original break's bounds are retained until its same-zone full reclaim or expiry.
_pivotEvents(array<box> _x, array<bool> _y, array<PivotZoneState> _states) =>
    int _up = 0
    int _dn = 0
    bool _falseDn = false
    bool _falseUp = false
    string _upText = ''
    string _dnText = ''
    string _falseDnText = ''
    string _falseUpText = ''
    if confirmed
        for i = 0 to array.size(_x) - 1
            _b = array.get(_x, i)
            _state = array.get(_states, i)
            _isBull = array.get(_y, i)
            if not na(_b) and not na(_state) and not na(_isBull)
                _t = box.get_top(_b)
                _btm = box.get_bottom(_b)
                _geometryChanged = _t != _state.top or _btm != _state.btm
                if _geometryChanged or _state.born == sync
                    _state.top := _t
                    _state.btm := _btm
                    _state.breakBar := na
                    _state.breakDir := 0
                    _state.breakTop := na
                    _state.breakBtm := na
                    // A zone can already have changed role before its delayed pivot confirmation.
                    // Initialize that role silently: its insertion/alignment is not a price break.
                    if close > _t
                        _isBull := true
                    else if close < _btm
                        _isBull := false
                    array.set(_y, i, _isBull)
                    box.set_border_color(_b, _isBull ? bullBorder : bearBorder)
                    box.set_bgcolor(_b, _isBull ? bullBgCol : bearBgCol)
                else
                    if not na(_state.breakBar) and sync - _state.breakBar > lookback
                        _state.breakBar := na
                        _state.breakDir := 0
                    _upBreak = not _isBull and close > _t
                    _dnBreak = _isBull and close < _btm
                    if _upBreak or _dnBreak
                        _reclaimDn = _upBreak and _state.breakDir == -1 and not na(_state.breakBar) and sync > _state.breakBar and close > _state.breakTop
                        _reclaimUp = _dnBreak and _state.breakDir == 1 and not na(_state.breakBar) and sync > _state.breakBar and close < _state.breakBtm
                        // Zone ids only feed alert messages, which are only sent on realtime bars
                        _idText = barstate.isrealtime ? _pivotIDText(_state) : ''
                        if _upBreak
                            _up += 1
                            _upText += (_upText == '' ? '' : ', ') + _idText
                        else
                            _dn += 1
                            _dnText += (_dnText == '' ? '' : ', ') + _idText
                        if _reclaimDn
                            _falseDn := true
                            _falseDnText += (_falseDnText == '' ? '' : ', ') + _idText
                        if _reclaimUp
                            _falseUp := true
                            _falseUpText += (_falseUpText == '' ? '' : ', ') + _idText
                        if _reclaimDn or _reclaimUp
                            _state.breakBar := na
                            _state.breakDir := 0
                        else
                            _state.breakBar := sync
                            _state.breakDir := _upBreak ? 1 : -1
                            _state.breakTop := _t
                            _state.breakBtm := _btm
                        box.set_extend(_b, extend.none)
                        _retire(_b, _isBull)
                        array.set(_x, i, _box(sync, _t, sync, _btm, _upBreak ? bullBorder : bearBorder, _upBreak ? bullBgCol : bearBgCol, extrap))
                        array.set(_y, i, _upBreak)
    [_up, _dn, _falseDn, _falseUp, _upText, _dnText, _falseDnText, _falseUpText]

//Count every zone the candle trades into, split by direction (does not stop at the first one)
_detect(_x,_y)      =>
    int  _bull      = 0
    int  _bear      = 0
    for i = 0 to               array.size       (_x) -1
        [t_, b_] =             _getBox          (_x, i)
        _isBull  =             array.get        (_y, i)
        if low <= t_ and high >= b_ and not na(_isBull)
            if _isBull
                _bull       += 1
            else
                _bear       += 1
    [_bull, _bear]

_numLevel(_x,_y)    =>
    int _above      = 0
    int _fill       = 0
    for i = 0 to               array.size       (_x)-1
        _isBull     =          array.get        (_x,i)
        if  _isBull
            _above += 1
        if  not na(_isBull)
            _fill  += 1
    for i = 0 to               array.size       (_y)-1
        _isBull     =          array.get        (_y,i)
        if  _isBull
            _above += 1
        if  not na(_isBull)
            _fill  += 1
    [_above, _fill]

_check(_src,_l)     =>
    bool _check     = false
    for i = 0 to _l
        if _src[i]
            _check := true
    _check

_count(_src, _l)    =>
    int _result     = 0
    for i = 0 to _l
        if _src > _src[i]
            _result += 1
    _result

_label(_x, _y, y, _s, _col1, _col2) =>
    transp = math.min   (color.t(_col1),  color.t(_col2))
    array.unshift       (_x,   label.new (sync+fut,   y                                        ,
                                          text      = str.tostring(math.round_to_mintick(y)   ),
                                          color     = color.new(_col1, transp)                 ,
                                          style     = _s                                       ,
                                          textcolor = priceNumberColor                        ))
    if not extend and fut > 0
        array.unshift   (_y,   line.new  (sync, y, sync+fut, y, color= color.new(_col1, transp)))

_level(_x, _y)          =>
    var label [] lab    =      array.new_label  (nPiv)
    var line  [] lines  =      array.new_line   (nPiv)
    if barstate.islast and lLab
        _delLevels             (lab, lines)
        for i = 0 to           array.size       (_x)-1
            [_t, _b]    =      _getBox          (_x,i)
            if not aoi_ok(_t, _b)
                continue
            _isBull     =      array.get        (_y,i)
            _col1        =     _isBull ?        bullBgCol  : bearBgCol
            _col2        =     _isBull ?        bullBorder : bearBorder
            if close >  _t
                _label  (lab, lines, _t, labUp, _col1, _col2)
            if close <  _b
                _label  (lab, lines, _b, labDn, _col1, _col2)
            if close <  _t and close >   _b
                _label  (lab, lines, _t, labDn, _col1, _col2)
                _label  (lab, lines, _b, labUp, _col1, _col2)

//Undo the display filter (_hideFar) of the previous execution before the zones are updated: colors from the
//zone direction, extension, and the right edge _extend gave it on the previous bar
_restore(_x, _y) =>
    for i = 0 to               array.size       (_x)-1
        _b       =             array.get        (_x, i)
        _isBull  =             array.get        (_y, i)
        if not na(_b) and not na(_isBull)
            box.set_border_color                (_b, _isBull ? bullBorder : bearBorder)
            box.set_bgcolor                     (_b, _isBull ? bullBgCol  : bearBgCol)
            box.set_extend                      (_b, extrap)
            box.set_right                       (_b, sync - 1)

//Display filter (last bar): zones outside the SMC drawing range (aoi_ok) are made transparent and their right
//edge is pulled back off screen (onto the first candle, or HIDE_BACK bars ago at most: placing a drawing farther
//back than the ~500 bar history buffer is a runtime error). Their prices are untouched for the zone logic
HIDE_BACK = 2 * AOI_BARS

_hideFar(_x) =>
    for i = 0 to               array.size       (_x)-1
        _b       =             array.get        (_x, i)
        if not na(_b) and not  aoi_ok           (box.get_top(_b), box.get_bottom(_b))
            box.set_extend                      (_b, extend.none)
            box.set_right                       (_b, math.max(box.get_left(_b), sync - HIDE_BACK))
            box.set_border_color                (_b, TRANSP_CSS)
            box.set_bgcolor                     (_b, TRANSP_CSS)

//Same filter for retired zones ending within the last AOI_BARS bars (older ones are off screen). A hidden zone is
//restored once it is back in range or off screen; the display step runs on every realtime bar, so its real right
//edge is then never more than about AOI_BARS bars back
_histDisplay() =>
    if  array.size                              (pivotHist) > 0
        for i = 0 to           array.size       (pivotHist)-1
            _b       =         array.get        (pivotHist, i)
            _r       =         array.get        (histRight, i)
            _isBull  =         array.get        (histBull, i)
            if not na(_b) and not na(_r) and not na(_isBull) and not na(box.get_left(_b))
                _hide    =     _r >= sync - AOI_BARS and not aoi_ok(box.get_top(_b), box.get_bottom(_b))
                _x       =     _hide ? math.max(box.get_left(_b), sync - HIDE_BACK) : _r
                if box.get_right(_b) != _x
                    box.set_right                   (_b, _x)
                box.set_border_color                (_b, _hide ? TRANSP_CSS : _isBull ? bullBorder : bearBorder)
                box.set_bgcolor                     (_b, _hide ? TRANSP_CSS : _isBull ? bullBgCol  : bearBgCol)

// Pattern labels can be provisional if requested, but messages are irreversible and wait for close.
// Aggregate all eligible events so once_per_bar does not silently discard simultaneous events.
_alert(_x, _y) =>
    if _x and confirmed
        array.push(pivotAlertMessages, _y + timeframe.period + ' chart. Price is ' + str.tostring(close))

// BjCandlePatterns/2 gravestoneDoji duplicates dragonfly's upper-wick test.
// Keep its fixed 5% doji definition but test the opposite (lower) wick correctly.
_gravestoneDoji() =>
    _range = high - low
    _body = math.abs(close - open)
    _lowerWick = math.min(open, close) - low
    _range > 0 and _body <= _range * 0.05 and _lowerWick <= _body

_spinningLab(_show, _atSupport) =>
    if _show
        label.new(bar_index, na, text='ST', yloc=_atSupport ? yloc.belowbar : yloc.abovebar,
          color=labNeutCol, style=_atSupport ? label.style_label_up : label.style_label_down,
          textcolor=textNeutCol, tooltip='Spinning Top\nNeutral small-body candle with long opposing wicks. Pivot ' + (_atSupport ? 'support' : 'resistance') + ' provides its location context; the candle may close up or down')

// ================================== //
// ----> Variable Calculations <----- //
// ================================== //

shortvar        =   tsifast ?           shortf  :       shorts
longvar         =   tsifast ?           longf   :       longs
signalvar       =   tsifast ?           signalf :       signals

tsi             =   ta.tsi              (close,         shortvar,   longvar)
tsl             =   ta.ema              (tsi,           signalvar)

highest         =   close ==            ta.highest      (close,     right)
lowest          =   close ==            ta.lowest       (close,     right)

closeLows       =   ta.lowest           (close,         swing)
closeHigh       =   ta.highest          (close,         swing)

numLows         =   _count              (low,           reflect)
numHigh         =   _count              (high,          reflect)

[open_, close_] =   _haBody             ()

hiHaBod         =   math.max            (close_,        open_)
loHaBod         =   math.min            (close_,        open_)

hiBod           =   math.max            (close,         open)
loBod           =   math.min            (close,         open)

srcHigh         =   haSrc ?             hiHaBod :       hiLoSrc ?   high :      hiBod
srcLow          =   haSrc ?             loHaBod :       hiLoSrc ?   low  :      loBod

pivot_high      =   ta.pivothigh        (srcHigh,       left,       right)
pivot_low       =   ta.pivotlow         (srcLow,        left,       right)

perc            =   close*              (per/100)

band            =   math.min            (zoneAtr*mult,  perc)       [right]     /2

HH              =   pivot_high+         band
HL              =   pivot_high-         band

LH              =   pivot_low+          band
LL              =   pivot_low-          band

coDiff          =   close -             open

// ================================== //
// --------> Logical Order <--------- //
// ================================== //

//Zones are only hidden on the last bar, so only realtime executions can find one hidden
if barstate.isrealtime
    _restore        (pivotHigh,     highBull)
    _restore        (pivotLows,     lowsBull)

newPivotHigh = not na(pivot_high) and not na(HH) and not na(HL) and dhighs and confirmed
newPivotLow = not na(pivot_low) and not na(LH) and not na(LL) and dlows and confirmed
if newPivotHigh
    pivotNextID += 1
    hiOut = _arrayLoad(highBull, nPiv, false)
    _arrayBox(pivotHigh, nPiv, _box(sync[right], HH, sync, HL, bearBorder, bearBgCol, extrap), hiOut)
    _stateLoad(highState, PivotZoneState.new(pivotNextID, sync, HH, HL, int(na), 0, float(na), float(na)))

if newPivotLow
    pivotNextID += 1
    loOut = _arrayLoad(lowsBull, nPiv, true)
    _arrayBox(pivotLows, nPiv, _box(sync[right], LH, sync, LL, bullBorder, bullBgCol, extrap), loOut)
    _stateLoad(lowState, PivotZoneState.new(pivotNextID, sync, LH, LL, int(na), 0, float(na), float(na)))

// Align only the newly inserted zone. Never rewrite an older pending break's geometry.
if alignZones and newPivotHigh
    _align(pivotHigh, pivotHigh)
    _align(pivotLows, pivotHigh)
if alignZones and newPivotLow
    _align(pivotHigh, pivotLows)
    _align(pivotLows, pivotLows)

_extend(pivotHigh)
_extend(pivotLows)

[highUp, highDn, highFalseDn, highFalseUp, highUpText, highDnText, highFalseDnText, highFalseUpText] = _pivotEvents(pivotHigh, highBull, highState)
[lowUp, lowDn, lowFalseDn, lowFalseUp, lowUpText, lowDnText, lowFalseDnText, lowFalseUpText] = _pivotEvents(pivotLows, lowsBull, lowState)

// ================================== //
// ----> Conditional Parameters <---- //
// ================================== //

isLows          =   closeLows      ==   close
isHigh          =   closeHigh      ==   close

wasLows         =   _check              (isLows,        lookback)
wasHigh         =   _check              (isHigh,        lookback)

[above, total]  =   _numLevel           (highBull,      lowsBull)

resBreak = confirmed and highUp + lowUp > 0
supBreak = confirmed and highDn + lowDn > 0
// A breakout clears every currently tracked pivot zone, and must include an actual close break.
breakOut = resBreak and highest and total > 0 and above == total
breakDwn = supBreak and lowest and total > 0 and above == 0
falseBreakBull = confirmed and wasLows and (highFalseDn or lowFalseDn)
falseBreakBear = confirmed and wasHigh and (highFalseUp or lowFalseUp)


[hBull, hBear]  =   _detect             (pivotHigh,     highBull)
[lBull, lBear]  =   _detect             (pivotLows,     lowsBull)

zoneBull        =   hBull + lBull
zoneBear        =   hBear + lBear

//All overlapped zones bullish = bull, all bearish = bear, bullish + bearish together = conflict (neither)
zoneConflict    =   zoneBull > 0  and   zoneBear > 0
bull            =   zoneBull > 0  and   zoneBear == 0
bear            =   zoneBear > 0  and   zoneBull == 0

bullCheck       =   confirmed and not resBreak  and   not resBreak[1] and close > open and bull
bearCheck       =   confirmed and not supBreak  and   not supBreak[1] and close < open and bear

rankOffset      =   math.min(offset, reflect)
highrange       =   reflect-rankOffset
lowsrange       =   rankOffset

sigLows         =   numLows        <=   lowsrange
sigHigh         =   numHigh        >=   highrange

isBull1         =   sigLows       and   bull
isBear1         =   sigHigh       and   bear

// A prior touch can qualify a two-bar resolution outside the zone, but current
// opposing/conflicting zones veto the direction rather than being bypassed.
isBull2         =   not zoneConflict and not bear and (sigLows or sigLows[1]) and (bull or bull[1])
isBear2         =   not zoneConflict and not bull and (sigHigh or sigHigh[1]) and (bear or bear[1])

data            =   tsi > tsi[1]  and   tsi < tsl
dtat            =   tsi < tsi[1]  and   tsi > tsl

hMatch          =   not colorMatch or   close > open
sMatch          =   not colorMatch or   close < open

hsFilter        =   bj.barRange()  >=   hammerSize * zoneAtr
atrMaxSize      =   bj.barRange()  <=   atrMax     * zoneAtr or atrMax == 0.0

rp              =   confirmed  or not   repaint

// ================================== //
// -----> Pattern Recognition <------ //
// ================================== //

dw              =   isBull1 and rp and d_  and atrMaxSize and bj.doji              (dojiSize           = dojiSize,         dojiWickSize    = dojiWickSize)
db              =   isBear1 and rp and d_  and atrMaxSize and bj.doji              (dojiSize           = dojiSize,         dojiWickSize    = dojiWickSize)
bew             =   isBull2 and rp and be_ and atrMaxSize and bj.bullEngulf        (maxRejectWick      = rejectWickMax,    mustEngulfWick  = ecWick)
beb             =   isBear2 and rp and be_ and atrMaxSize and bj.bearEngulf        (maxRejectWick      = rejectWickMax,    mustEngulfWick  = ecWick)
h               =   isBull1 and rp and hs_ and atrMaxSize and bj.hammer            (ratio              = hammerFib,        shadowPercent   = hsShadowPerc) and hsFilter and hMatch
ss              =   isBear1 and rp and hs_ and atrMaxSize and bj.star              (ratio              = hammerFib,        shadowPercent   = hsShadowPerc) and hsFilter and sMatch
dd              =   isBull1 and rp and dg_ and atrMaxSize and bj.dragonflyDoji     ()
gd              =   isBear1 and rp and dg_ and atrMaxSize and _gravestoneDoji     ()
tb              =   isBull2 and rp and tw_ and atrMaxSize and bj.tweezerBottom     (closeUpperHalf     = closeHalf)
tt              =   isBear2 and rp and tw_ and atrMaxSize and bj.tweezerTop        (closeLowerHalf     = closeHalf)
stw             =   isBull1 and rp and st_ and atrMaxSize and bj.spinningTop       ()
stb             =   isBear1 and rp and st_ and atrMaxSize and bj.spinningTop       ()
p               =   isBull1 and rp and pc_ and atrMaxSize and bj.piercing          ()
dcc             =   isBear1 and rp and pc_ and atrMaxSize and bj.darkCloudCover    ()
bhw             =   isBull1 and rp and bh_ and atrMaxSize and bj.haramiBull        ()
bhb             =   isBear1 and rp and bh_ and atrMaxSize and bj.haramiBear        ()
ll              =   isBull1 and rp and ls_ and atrMaxSize and bj.lls               (ratio              = luRatio)          and hsFilter
lu              =   isBear1 and rp and ls_ and atrMaxSize and bj.lus               (ratio              = luRatio)          and hsFilter

// ================================== //
// ------> Graphical Display <------- //
// ================================== //

plotFalseDn     =   falseBull     and   falseBreakBull
plotFalseUp     =   falseBear     and   falseBreakBear

falseUpCol      =   plotFalseUp     ?   upCol       :   na
falseDnCol      =   plotFalseDn     ?   dnCol       :   na

plotBreakOut    =   breakOut      and   detectBO    and not     plotFalseDn
plotBreakDn     =   breakDwn      and   detectBD    and not     plotFalseUp

plotResBreak    =   resBreak      and   breakUp     and not     (plotBreakOut or plotFalseDn)
plotSupBreak    =   supBreak      and   breakDn     and not     (plotBreakDn  or plotFalseUp)

plotBullCheck   =   bullCheck     and   supPush
plotBearCheck   =   bearCheck     and   resPush

plotCurlBull    =   confirmed and curl and data and bull
plotCurlBear    =   confirmed and curl and dtat and bear

//Arrow direction follows the signal (false break up = bearish = down arrow), not the candle color
plotarrow           (plotFalseUp ? -math.max(math.abs(coDiff), syminfo.mintick) : na      ,   colorup  = fBull          ,     colordown=      fBear ,         maxheight=      arrowMax)
plotarrow           (plotFalseDn ?  math.max(math.abs(coDiff), syminfo.mintick) : na      ,   colorup  = fBull          ,     colordown=      fBear ,         maxheight=      arrowMax)

plotshape           (plotBreakOut   ,   style=shape.arrowup     ,   location=location.belowbar,     color=          upCol ,         size=           size.small)
plotshape           (plotBreakDn    ,   style=shape.arrowdown   ,   location=location.abovebar,     color=          dnCol ,         size=           size.small)

plotshape           (plotResBreak   ,   style=shape.arrowup     ,   location=location.belowbar,     color=          supCol,         size=           size.small)
plotshape           (plotSupBreak   ,   style=shape.arrowdown   ,   location=location.abovebar,     color=          resCol,         size=           size.small)

plotshape           (plotBullCheck  ,   style=shape.triangleup  ,   location=location.belowbar,     color=          moveBullCol)
plotshape           (plotBearCheck  ,   style=shape.triangledown,   location=location.abovebar,     color=          moveBearCol)

plotshape           (plotCurlBull   ,   style=shape.triangleup  ,   location=location.belowbar,     color=          curlBullCol)
plotshape           (plotCurlBear   ,   style=shape.triangledown,   location=location.abovebar,     color=          curlBearCol)

bj.dLab             (dw  and labels, labNeutCol, textNeutCol), _wrap (dw  and sBox, boxes, 1, patNeutBo, patNeutBg)
bj.bewLab           (bew and labels, labBullCol, textBullCol), _wrap (bew and sBox, boxes, 2, patBullBo, patBullBg)
bj.hLab             (h   and labels, labBullCol, textBullCol), _wrap (h   and sBox, boxes, 1, patBullBo, patBullBg)
bj.ddLab            (dd  and labels, labBullCol, textBullCol), _wrap (dd  and sBox, boxes, 1, patBullBo, patBullBg)
bj.tbLab            (tb  and labels, labBullCol, textBullCol), _wrap (tb  and sBox, boxes, 2, patBullBo, patBullBg)
_spinningLab        (stw and labels, true), _wrap (stw and sBox, boxes, 1, patBullBo, patNeutBg)
bj.pLab             (p   and labels, labBullCol, textBullCol), _wrap (p   and sBox, boxes, 2, patBullBo, patBullBg)
bj.hwLab            (bhw and labels, labBullCol, textBullCol), _wrap (bhw and sBox, boxes, 2, patBullBo, patBullBg)
bj.llsLab           (ll  and labels, labBullCol, textBullCol), _wrap (ll  and sBox, boxes, 1, patBullBo, patBullBg)

bj.dLab             (db  and labels, labNeutCol, textNeutCol), _wrap (db  and sBox, boxes, 1, patNeutBo, patNeutBg)
bj.bebLab           (beb and labels, labBearCol, textBearCol), _wrap (beb and sBox, boxes, 2, patBearBo, patBearBg)
bj.ssLab            (ss  and labels, labBearCol, textBearCol), _wrap (ss  and sBox, boxes, 1, patBearBo, patBearBg)
bj.gdLab            (gd  and labels, labBearCol, textBearCol), _wrap (gd  and sBox, boxes, 1, patBearBo, patBearBg)
bj.ttLab            (tt  and labels, labBearCol, textBearCol), _wrap (tt  and sBox, boxes, 2, patBearBo, patBearBg)
_spinningLab        (stb and labels, false), _wrap (stb and sBox, boxes, 1, patBearBo, patBearBg)
bj.dccLab           (dcc and labels, labBearCol, textBearCol), _wrap (dcc and sBox, boxes, 2, patBearBo, patBearBg)
bj.hbLab            (bhb and labels, labBearCol, textBearCol), _wrap (bhb and sBox, boxes, 2, patBearBo, patBearBg)
bj.lusLab           (lu  and labels, labBearCol, textBearCol), _wrap (lu  and sBox, boxes, 1, patBearBo, patBearBg)

_level              (pivotHigh, highBull)
_level              (pivotLows, lowsBull)

if barstate.islast
    _hideFar        (pivotHigh)
    _hideFar        (pivotLows)
    _histDisplay    ()

// ================================== //
// -----> Alert Functionality <------ //
// ================================== //

//Alert conditions match exactly what is plotted (enable the Detection toggle to use them)
alertcondition      (plotResBreak   ,   'Resistance break'                      ,   'Resistance broke on {{interval}} chart. Price is {{close}}'                    )
alertcondition      (plotSupBreak   ,   'Support break'                         ,   'Support broke on {{interval}} chart. Price is {{close}}'                       )
alertcondition      (plotBullCheck  ,   'Found support'                         ,   'Pushing Off Key Level Support on {{interval}} chart. Price is {{close}}'       )
alertcondition      (plotBearCheck  ,   'Found resistance'                      ,   'Pushing Off Key Level Resistance on {{interval}} chart. Price is {{close}}'    )
alertcondition      (plotFalseDn    ,   'False break down'                      ,   'False Break Down on {{interval}} chart. Price is {{close}}'                    )
alertcondition      (plotFalseUp    ,   'False break up'                        ,   'False Break Up on {{interval}} chart. Price is {{close}}'                      )
alertcondition      (plotBreakOut   ,   'Breakout'                              ,   'Breakout on {{interval}} chart. Price is {{close}}'                            )
alertcondition      (plotBreakDn    ,   'Breakdown'                             ,   'Breakdown on {{interval}} chart. Price is {{close}}'                           )

//alert() never fires on historical bars, so the messages are only built on realtime bars
if barstate.isrealtime
    resBreakText = highUpText + (highUpText != '' and lowUpText != '' ? ', ' : '') + lowUpText
    supBreakText = highDnText + (highDnText != '' and lowDnText != '' ? ', ' : '') + lowDnText
    falseDnText = highFalseDnText + (highFalseDnText != '' and lowFalseDnText != '' ? ', ' : '') + lowFalseDnText
    falseUpText = highFalseUpText + (highFalseUpText != '' and lowFalseUpText != '' ? ', ' : '') + lowFalseUpText
    _alert              (plotResBreak   ,   'Resistance broke ' + resBreakText + ' on '                  )
    _alert              (plotSupBreak   ,   'Support break ' + supBreakText + ' on '                        )
    _alert              (plotBullCheck  ,   'Pushing off key level support on '     )
    _alert              (plotBearCheck  ,   'Pushing off key level resistance on '  )
    _alert              (plotFalseDn    ,   'False break down ' + falseDnText + ' on '                  )
    _alert              (plotFalseUp    ,   'False break up ' + falseUpText + ' on '                    )
    _alert              (plotBreakOut   ,   'Breakout ' + resBreakText + ' on '                          )
    _alert              (plotBreakDn    ,   'Breakdown ' + supBreakText + ' on '                         )

    _alert              (dw             ,   'Doji at support on '                   )
    _alert              (db             ,   'Doji at resistance on '                )
    _alert              (bew            ,   'Bullish Engulfing on '                 )
    _alert              (beb            ,   'Bearish Engulfing on '                 )
    _alert              (h              ,   'Hammer candle on '                     )
    _alert              (ss             ,   'Shooting star on '                     )
    _alert              (dd             ,   'Dragonfly Doji on '                    )
    _alert              (gd             ,   'Gravestone Doji on '                   )
    _alert              (tb             ,   'Tweezer Bottom on '                    )
    _alert              (tt             ,   'Tweezer Top on '                       )
    _alert              (stw            ,   'Neutral Spinning Top at support on '                )
    _alert              (stb            ,   'Neutral Spinning Top at resistance on '                )
    _alert              (p              ,   'Piercing on '                          )
    _alert              (dcc            ,   'Dark Cloud Cover on '                  )
    _alert              (bhw            ,   'Bullish Harami on '                    )
    _alert              (bhb            ,   'Bearish Harami on '                    )
    _alert              (ll             ,   'Long Lower Shadow on '                 )
    _alert              (lu             ,   'Long Upper Shadow on '                 )
    //

    if array.size(pivotAlertMessages) > 0
        alert(array.join(pivotAlertMessages, '\n'), alertMode)
//
//Directions
directions = input.bool(true, title="Directions Dashboard", group="Info الاتجاه", tooltip="Show secondary directional context. To reorder rows, swap BOTH position numbers. On/Off controls row visibility; all-nine alerts still require all nine calculations.")

//Table On/Off
infoDataTableOn = input.bool(true, title="الاتجاه On/Off", group="Info الاتجاه")

//Table Positions
bright = position.bottom_right
bleft = position.bottom_left
bcenter = position.bottom_center
tright = position.top_right
tleft = position.top_left
tcenter = position.top_center
mright = position.middle_right
mleft = position.middle_left
mcenter = position.middle_center
itablePosition = input.string(bright, title="1", options=[bright, bleft, bcenter, tright, tleft, tcenter, mright, mleft, mcenter], group="Info الاتجاه")

//Lengths
macdOn = input.bool(true, title="Turn MACD Label On/Off", group="MACD Settings")
macdOrder = input.int(1, title="Place On The List", minval=1, maxval=9, group="MACD Settings")
macdFast = input.int(12, title="MACD Fast Length", minval=2, maxval=500, group="MACD Settings")
macdSlow = input.int(26, title="MACD Slow Length", minval=2, maxval=500, group="MACD Settings")
macdSignal = input.int(9, title="MACD Signal Length", minval=2, maxval=500, group="MACD Settings")
stochasticOn = input.bool(true, title="Turn Stochstic RSI Label On/Off", group="Stochastic RSI Settings")
stochasticOrder = input.int(2, title="Place On The List", minval=1, maxval=9, group="Stochastic RSI Settings")
smoothK = input.int(3, "K Value - Stochastic RSI", minval=2, maxval=500, group="Stochastic RSI Settings")
smoothD = input.int(3, "D Value - Stochastic RSI", minval=2, maxval=100, group="Stochastic RSI Settings", tooltip="Used by K vs D direction mode. K vs 50 uses K only.")
stochDirectionMode = input.string("K vs 50", "Direction Rule", options=["K vs 50", "K vs D"], group="Stochastic RSI Settings")
lengthRSI = input.int(14, "Stochastic RSI Length", minval=2, maxval=500, group="Stochastic RSI Settings")
lengthStoch = input.int(14, "Stochastic Length", minval=2, maxval=500, group="Stochastic RSI Settings")
vortexOn = input.bool(true, title="Turn Vortex Label On/Off", group="Vortex Settings")
vortexOrder = input.int(3, title="Place On The List", minval=1, maxval=9, group="Vortex Settings")
vortexLength = input.int(14, title="Vortex Length", minval=2, maxval=500, group="Vortex Settings")
momOn = input.bool(true, title="Turn Momentum Label On/Off", group="Momentum Settings")
momOrder = input.int(4, title="Place On The List", minval=1, maxval=9, group="Momentum Settings")
momLength = input.int(10, title="Momentum Length", minval=2, maxval=500, group="Momentum Settings", tooltip="Close compared with its value this many bars ago. Positive = bullish, negative = bearish; a directional context reading, not an entry signal.")
rsiOn = input.bool(true, title="Turn RSI Label On/Off", group="RSI Settings")
rsiOrder = input.int(5, title="Place On The List", minval=1, maxval=9, group="RSI Settings")
rsiLength = input.int(14, title="Relative Strength Index Length", minval=2, maxval=500, group="RSI Settings")
psarOn = input.bool(true, title="Turn PSAR Label On/Off", group="PSAR Settings")
psarOrder = input.int(6, title="Place On The List", minval=1, maxval=9, group="PSAR Settings")
psarStart = input.float(.02, title="PSAR Start", minval=.01, group="PSAR Settings")
psarInc = input.float(.02, title="PSAR Increment", minval=.01, group="PSAR Settings")
psarMax = input.float(.2, title="PSAR Max", minval=.01, group="PSAR Settings")
dmiOn = input.bool(true, title="Turn DMI Label On/Off", group="DMI Settings")
dmiOrder = input.int(7, title="Place On The List", minval=1, maxval=9, group="DMI Settings")
dmiLength = input.int(14, title="DMI Length", minval=2, maxval=500, group="DMI Settings")
dmiSmooth = input.int(14, title="DMI Smoothing", minval=2, maxval=500, group="DMI Settings")
adxThreshold = input.float(0, title="ADX Trend Threshold", minval=0, group="DMI Settings", tooltip="DMI shows wait while ADX is below this level. 0 = always show the DI+/DI- direction. ADX measures trend strength, not direction.")
mfiOn = input.bool(true, title="Turn Money Flow Index Label On/Off", group="Money Flow Index Settings")
mfiOrder = input.int(8, title="Place On The List", minval=1, maxval=9, group="Money Flow Index Settings")
mfiLength = input.int(14, title="Money Flow Index Length", minval=2, maxval=500, group="Money Flow Index Settings")
fisherOn = input.bool(true, title="Turn Fisher Label On/Off", group="Fisher Settings")
fisherOrder = input.int(9, title="Place On The List", minval=1, maxval=9, group="Fisher Settings")
fisherLength = input.int(14, title="Fisher Length", minval=2, maxval=500, group="Fisher Settings")

//Fisher Transform
high_ = ta.highest(hl2, fisherLength)
low_ = ta.lowest(hl2, fisherLength)
round_(val) => val > .99 ? .999 : val < -.99 ? -.999 : val
value = 0.0
fisherRange = high_ - low_
fisherReady = not na(fisherRange) and fisherRange > 0
value := fisherReady ? round_(.66 * ((hl2 - low_) / fisherRange - .5) + .67 * nz(value[1])) : nz(value[1])
fish1 = 0.0
fish1 := .5 * math.log((1 + value) / (1 - value)) + .5 * nz(fish1[1])
fish2 = fish1[1]

//Stochastic RSI
rsi1 = ta.rsi(close, lengthRSI)
k = ta.sma(ta.stoch(rsi1, rsi1, rsi1, lengthStoch), smoothK)
d = ta.sma(k, smoothD)

//Vortex
VMP = math.sum( math.abs( high - low[1]), vortexLength)
VMM = math.sum( math.abs( low - high[1]), vortexLength)
STR = math.sum( ta.atr(1), vortexLength)
vortexReady = not na(STR) and STR > 0
VIP = vortexReady ? VMP / STR : na
VIM = vortexReady ? VMM / STR : na

//DMI
[diplus, diminus, adx] = ta.dmi(dmiLength, dmiSmooth)

//PSAR
psar = ta.sar(psarStart, psarInc, psarMax)

//Momentum
mom = ta.mom(close, momLength)

//Money Flow Index
mfiRaw = ta.mfi(close, mfiLength)
mfiVolume = math.sum(nz(volume), mfiLength)
mfiMissing = math.sum(na(volume) ? 1 : 0, mfiLength)
mfiReady = mfiMissing == 0 and mfiVolume > 0 and not na(mfiRaw)
mfi = mfiReady ? mfiRaw : na

//RSI
rsi = ta.rsi(close, rsiLength)

//MACD
[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSignal)

//Create MACD indicator label table data
macdIndicatorLabel = '  MACD    wait '
macdLabel = color.blue
if macdLine > signalLine
    macdLabel := color.lime
    macdIndicatorLabel := " MACD    buy "
else if macdLine < signalLine
    macdLabel := color.red
    macdIndicatorLabel := " MACD     sell "

//Create Stochastic RSI indicator label table data
//Direction rule is selected explicitly. Values at 80/20 are tagged OB/OS without reversing their direction.
stochIndicatorLabel = 'Stoch    wait '
stochLabel = color.blue
if stochDirectionMode == "K vs 50" ? k > 50 : k > d
    stochLabel := color.lime
    stochIndicatorLabel := k >= 80 ? " Stoch    buy OB " : " Stoch    buy "
else if stochDirectionMode == "K vs 50" ? k < 50 : k < d
    stochLabel := color.red
    stochIndicatorLabel := k <= 20 ? " Stoch      sell OS " : " Stoch      sell "

//Create Vortex indicator label table data
vortexIndicatorLabel = '  Vortex   wait '
vortexLabel = color.blue
if VIP > VIM
    vortexLabel := color.lime
    vortexIndicatorLabel := " Vortex    buy "
else if VIP < VIM
    vortexLabel := color.red
    vortexIndicatorLabel := " Vortex    sell "

//Create MFI indicator label table data
//Direction = above/below 50; overbought/oversold (80/20) keep their direction and are tagged OB/OS
//Extreme readings describe stretched directional context; they are not standalone reversal entries.
mfiIndicatorLabel = mfiReady ? 'MFI        wait ' : 'MFI        no volume '
mfiLabel = color.blue
if mfi > 50
    mfiLabel := color.lime
    mfiIndicatorLabel := mfi >= 80 ? " MFI        buy OB " : " MFI        buy "
else if mfi < 50
    mfiLabel := color.red
    mfiIndicatorLabel := mfi <= 20 ? " MFI        sell OS " : " MFI        sell "

//Create Fisher indicator label table data
fisherIndicatorLabel = '  Fisher   wait '
fisherLabel = color.blue
if fisherReady and fish1 > fish2
    fisherLabel := color.lime
    fisherIndicatorLabel := " Fisher    buy "
else if fisherReady and fish1 < fish2
    fisherLabel := color.red
    fisherIndicatorLabel := " Fisher     sell "

//Create DMI indicator label table data
//DI+/DI- direction; shows wait only while ADX is below the threshold input (0 by default)
dmiIndicatorLabel = '  DMI       wait '
dmiLabel = color.blue
if adx >= adxThreshold and diplus > diminus
    dmiLabel := color.lime
    dmiIndicatorLabel := " DMI        buy "
else if adx >= adxThreshold and diplus < diminus
    dmiLabel := color.red
    dmiIndicatorLabel := " DMI        sell "

//Create Momentum indicator label table data
//Sign of momentum (close vs close n bars ago), not its bar-to-bar slope
momIndicatorLabel = '  Mom      wait '
momLabel = color.blue
if mom > 0
    momLabel := color.lime
    momIndicatorLabel := " Mom      buy "
else if mom < 0
    momLabel := color.red
    momIndicatorLabel := " Mom       sell "

//Create PSAR indicator label table data
psarIndicatorLabel = '  PSAR     wait '
psarLabel = color.blue
if close > psar
    psarLabel := color.lime
    psarIndicatorLabel := " PSAR     buy "
else if close < psar
    psarLabel := color.red
    psarIndicatorLabel := " PSAR      sell "

//Create RSI indicator label table data
//Direction = above/below 50; overbought/oversold (70/30) keep their direction and are tagged OB/OS
//Extreme readings describe stretched directional context; they are not standalone reversal entries.
rsiIndicatorLabel = '  RSI        wait '
rsiLabel = color.blue
if rsi > 50
    rsiLabel := color.lime
    rsiIndicatorLabel := rsi >= 70 ? " RSI        buy OB " : " RSI        buy "
else if rsi < 50
    rsiLabel := color.red
    rsiIndicatorLabel := rsi <= 30 ? " RSI         sell OS " : " RSI         sell "

//Plot Price Difference Table (created once, filled on the last bar)
var infoDataTable = table.new(itablePosition, columns=1, rows=10)
if directions and infoDataTableOn and barstate.islast
    table.cell(table_id=infoDataTable, column=0, row=mfiOrder, text=mfiOn ? mfiIndicatorLabel : na, height=0, text_color=color.white, text_halign=text.align_left, text_valign=text.align_top, bgcolor=mfiLabel)
    table.cell(table_id=infoDataTable, column=0, row=fisherOrder, text=fisherOn ? fisherIndicatorLabel : na, height=0, text_color=color.white, text_halign=text.align_left, text_valign=text.align_top, bgcolor=fisherLabel)
    table.cell(table_id=infoDataTable, column=0, row=dmiOrder, text=dmiOn ? dmiIndicatorLabel : na, height=0, text_color=color.white, text_halign=text.align_left, text_valign=text.align_top, bgcolor=dmiLabel)
    table.cell(table_id=infoDataTable, column=0, row=momOrder, text=momOn ? momIndicatorLabel : na, height=0, text_color=color.white, text_halign=text.align_left, text_valign=text.align_top, bgcolor=momLabel)
    table.cell(table_id=infoDataTable, column=0, row=psarOrder, text=psarOn ? psarIndicatorLabel : na, height=0, text_color=color.white, text_halign=text.align_left, text_valign=text.align_top, bgcolor=psarLabel)
    table.cell(table_id=infoDataTable, column=0, row=rsiOrder, text=rsiOn ? rsiIndicatorLabel : na, height=0, text_color=color.white, text_halign=text.align_left, text_valign=text.align_top, bgcolor=rsiLabel)
    table.cell(table_id=infoDataTable, column=0, row=macdOrder, text=macdOn ? macdIndicatorLabel : na, height=0, text_color=color.white, text_halign=text.align_left, text_valign=text.align_top, bgcolor=macdLabel)
    table.cell(table_id=infoDataTable, column=0, row=stochasticOrder, text=stochasticOn ? stochIndicatorLabel : na, height=0, text_color=color.white, text_halign=text.align_left, text_valign=text.align_top, bgcolor=stochLabel)
    table.cell(table_id=infoDataTable, column=0, row=vortexOrder, text=vortexOn ? vortexIndicatorLabel : na, height=0, text_color=color.white, text_halign=text.align_left, text_valign=text.align_top, bgcolor=vortexLabel)
    table.cell(table_id=infoDataTable, column=0, row=0, text=" direction", height=0, text_color=color.white, text_halign=text.align_left, text_valign=text.align_top, bgcolor=color.purple)

//Alerts
alertcondition(rsiLabel == color.red and mfiLabel == color.red and fisherLabel == color.red and dmiLabel == color.red and momLabel == color.red and psarLabel == color.red and
 macdLabel == color.red and stochLabel == color.red and vortexLabel == color.red, "All Bearish Indicators Alert", "All Bearish Indicators {{ticker}} {{interval}}")

alertcondition(rsiLabel == color.lime and mfiLabel == color.lime and fisherLabel == color.lime and dmiLabel == color.lime and momLabel == color.lime and psarLabel == color.lime and
 macdLabel == color.lime and stochLabel == color.lime and vortexLabel == color.lime, "All Bullish Indicators Alert", "All Bullish Indicators {{ticker}} {{interval}}")
 //
//////////////////////////////////////////////////////////////////////////////////////////


// BULB Indicator settings
// Moving (original): once RSI reaches Overbought the SELL label follows every new high, and once RSI
// reaches Oversold the BUY label follows every new low, so it ends at the swing extreme. It moves
// while the swing develops (repaints), so do not backtest it as a fixed entry.
// Fixed: SELL prints when RSI closes back below Overbought, BUY when it closes back above Oversold,
// on the confirmed bar, and never moves.
recommendation = input(true, title='BULB', group='BULB Signals')
bulbMode = input.string('Moving (original)', title='Mode', options=['Moving (original)', 'Fixed (confirmed)'], group='BULB Signals')
rsiLength1 = input.int(13, title='RSI Length', minval=2, maxval=500, group='BULB Signals')
rsiOverbought = input.int(65, title='Overbought', minval=51, maxval=100, group='BULB Signals')
rsiOvesold = input.int(30, title='Oversold', minval=0, maxval=49, group='BULB Signals')
bulbAlternate = input.bool(true, title='Alternate Buy/Sell (Fixed mode)', group='BULB Signals', tooltip='Fixed mode only. Only allow a SELL after a BUY (and vice versa), so a strong trend does not print repeated counter-trend signals')

rsiValue = ta.rsi(close, rsiLength1)
isOverbought = rsiValue >= rsiOverbought
isOversold = rsiValue <= rsiOvesold
bulbExitOB = ta.crossunder(rsiValue, rsiOverbought)
bulbExitOS = ta.crossover(rsiValue, rsiOvesold)
bulbMoving = bulbMode == 'Moving (original)'

var laststate = 0  // 1 = sell side active, 2 = buy side active
var hh = low
var ll1 = high
var label labelhh = na
var label labelll = na

bulbSell = false
bulbBuy = false

if recommendation and bulbMoving
    // A new SELL starts when RSI turns overbought after the buy side, a new BUY when it turns oversold after the sell side
    if laststate == 2 and isOverbought
        hh := high
        labelhh := label.new(x=bar_index, y=high, yloc=yloc.price, style=label.style_label_down, color=#F70700, size=size.normal, text='sell', textcolor=color.white)
        bulbSell := true
    if laststate == 1 and isOversold
        ll1 := low
        labelll := label.new(x=bar_index, y=low, yloc=yloc.price, style=label.style_label_up, color=#22E139, size=size.normal, text='buy', textcolor=color.white)
        bulbBuy := true

    if isOverbought
        laststate := 1
    if isOversold
        laststate := 2

    // The active label follows price to the best location: the highest high / lowest low of the swing
    if laststate == 1 and high >= hh
        hh := high
        label.set_xy(labelhh, bar_index, high)
    if laststate == 2 and low <= ll1
        ll1 := low
        label.set_xy(labelll, bar_index, low)

if recommendation and not bulbMoving
    bulbSell := barstate.isconfirmed and bulbExitOB and (not bulbAlternate or laststate != 1)
    bulbBuy := barstate.isconfirmed and bulbExitOS and (not bulbAlternate or laststate != 2)

    if bulbSell
        label.new(x=bar_index, y=high, yloc=yloc.price, style=label.style_label_down, color=#F70700, size=size.normal, text='sell', textcolor=color.white)
        laststate := 1

    if bulbBuy
        label.new(x=bar_index, y=low, yloc=yloc.price, style=label.style_label_up, color=#22E139, size=size.normal, text='buy', textcolor=color.white)
        laststate := 2

alertcondition(bulbBuy, 'BULB Buy', 'BULB buy on {{ticker}} {{interval}}. Price is {{close}}')
alertcondition(bulbSell, 'BULB Sell', 'BULB sell on {{ticker}} {{interval}}. Price is {{close}}')

// Custom ATR Bands settings
mal = input.int(47, title='SMA Length', minval=1, maxval=500, group='ATR Bands')
mva = ta.sma(close, mal)
atrl = input.int(89, title='Atr Length', minval=1, maxval=500, group='ATR Bands')
atrv = ta.atr(atrl)
atrm = input.float(3.0, title='Atr Multiplier', minval=0, step=0.25, group='ATR Bands')
bandWidth = input.int(1, title='Line Width', minval=1, maxval=4, group='ATR Bands')
pEnv = mva + mva * atrv / close * atrm
mEnv = mva - mva * atrv / close * atrm

plot(mva, title='Simple Moving Average', linewidth=bandWidth)
plot(pEnv, color=color.new(color.red, 0), title='High Envelope', linewidth=bandWidth)
plot(mEnv, color=color.new(color.green, 0), title='Low Envelope', linewidth=bandWidth)
