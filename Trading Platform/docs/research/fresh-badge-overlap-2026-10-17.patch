+import { useEffect, useMemo, useRef, useState } from 'react'
+import { BADGE_OVERLAP_DEFAULTS, badgeOverlapDrawings, fetchBadgeOverlaps } from '../api/badgeOverlap'
+import type { BadgeOverlapRequest, BadgeOverlapResult } from '../api/badgeOverlap'
+import type { DrawingObj, TimeframeCode } from '../api/types'
+import type { IndicatorInstance } from '../state/indicators'
+
+interface Job { uid: string; body: BadgeOverlapRequest }
+interface State { key: string; results: Record<string, BadgeOverlapResult>; error: string | null; loading: boolean }
+export function useBadgeOverlaps(instances: IndicatorInstance[], feedId: string | null, tf: TimeframeCode,
+  asOf: number | null, displayTime: number | null, step: number, precision: number, ready: boolean) {
+  const jobs: Job[] = ready && feedId && asOf !== null ? instances.flatMap(inst => {
+    const c = inst.badgeOverlap ?? BADGE_OVERLAP_DEFAULTS
+    if (inst.scriptId !== 'smc_ict_scalping_master' || !c.enabled || !inst.visible || !inst.timeframes.includes(tf)
+      || inst.groupVisible.demand_supply === false) return []
+    return [{uid: inst.uid, body: {feed_id: feedId, inputs: inst.inputs, as_of: asOf,
+      timeframes: c.timeframes.filter(t => inst.timeframes.includes(t)),
+      min_timeframes: c.minTimeframes, max_ranges: 8}}]
+  }) : []
+  const key = JSON.stringify({tf, displayTime, jobs})
+  const current = useRef(key)
+  const pending = useRef<{key: string; jobs: Job[]} | null>(null)
+  const running = useRef(false)
+  const mounted = useRef(true)
+  const [state, setState] = useState<State>({key: '', results: {}, error: null, loading: false})
+  useEffect(() => { mounted.current = true; return () => {mounted.current = false} }, [])
+  useEffect(() => {
+    current.current = key
+    const job = JSON.parse(key) as {jobs: Job[]}
+    pending.current = {key, jobs: job.jobs}
+    // One calculation in flight; while it runs, retain only the latest requested chart/replay clock.
+    if (running.current) return
+    running.current = true
+    void (async () => {
+      try {
+        while (pending.current) {
+          const next = pending.current
+          pending.current = null
+          try {
+            const entries: [string, BadgeOverlapResult][] = []
+            for (const j of next.jobs) entries.push([j.uid, await fetchBadgeOverlaps(j.body)])
+            if (mounted.current && current.current === next.key)
+              setState({key: next.key, results: Object.fromEntries(entries), error: null, loading: false})
+          } catch (e) {
+            if (mounted.current && current.current === next.key)
+              setState({key: next.key, results: {}, error: e instanceof Error ? e.message : String(e), loading: false})
+          }
+        }
+      } finally {running.current = false}
+    })()
+  }, [key])
+  const valid = state.key === key
+  const drawings = useMemo(() => {
+    const out: Record<string, DrawingObj[]> = {}
+    if (state.key === key && displayTime !== null) for (const [uid, data] of Object.entries(state.results))
+      out[uid] = badgeOverlapDrawings(data, displayTime, step, precision)
+    return out
+  }, [state, key, displayTime, step, precision])
+  return {drawings, enabled: jobs.length > 0, loading: !valid || state.loading, error: valid ? state.error : null,
+    warnings: valid ? Object.values(state.results).flatMap(d => d.warnings) : []}
+}
