# Copy to backend/.env and fill in. Never commit the real .env file.

# --- Preferred provider: Exness Public Trader API (market data only) ---
# Verification/MT5 login is not API access. Obtain these from Exness Key Management.
MARKET_DATA_PROVIDER=exness
EXN_API_KEY=
EXN_ACCOUNT_ID=
# Exact HTTPS host from the DNS widget; do not use the documentation URL or MT5 server.
EXN_API_BASE_URL=
# Prefer an ignored local file containing an Ed25519 PEM or a hex/base64url 32-byte seed.
# Relative paths resolve from backend/. No private key is sent to the browser.
EXN_PRIVATE_KEY_FILE=
# Alternatively set EXN_PRIVATE_KEY locally. Do not paste the secret into chat.
EXN_PRIVATE_KEY=
EXNESS_INSTRUMENTS=XAUUSD
EXNESS_PRICE_TYPE=bid
# Must match native H4/D1/W1/MN boundaries. UTC is a configuration choice, not verified broker parity.
# The parser rejects candles that do not match it, rather than shifting their timestamps.
EXNESS_ALIGNMENT=utc

# --- OANDA v20 (optional; without a token the app runs on imported CSV data) ---
# Personal access token from your OANDA account (Manage API Access).
OANDA_API_TOKEN=
# Optional: enables instrument details (display precision, trade size limits).
OANDA_ACCOUNT_ID=
# practice | live
OANDA_ENVIRONMENT=practice
# Candle price component: M (mid, default), B (bid) or A (ask)
OANDA_PRICE_COMPONENT=M
# Comma-separated OANDA instruments to expose
OANDA_INSTRUMENTS=XAU_USD
# Client-side request ceiling (OANDA allows more; stay polite)
OANDA_MAX_REQUESTS_PER_SECOND=20
# Native candle reconciliation interval; Exness also uses live WebSocket ticks.
LIVE_POLL_SECONDS=2

# --- Local settings ---
# SQLite database (relative paths are resolved from backend/)
DATABASE_PATH=data/market.db
# Worker processes for backtests
BACKTEST_WORKERS=2
# Origins allowed to call the API during development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
