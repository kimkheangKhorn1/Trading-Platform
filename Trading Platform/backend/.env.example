# Copy to backend/.env and fill in. Never commit the real .env file.

# --- OANDA v20 (optional; without a token the app runs on imported CSV data) ---
# Personal access token from your OANDA account (Manage API Access).
OANDA_API_TOKEN=
# Optional: enables instrument details (display precision, trade size limits).
OANDA_ACCOUNT_ID=
# practice | live
OANDA_ENVIRONMENT=practice
# Candle price component: M (mid, default), B (bid) or A (ask)
OANDA_PRICE_COMPONENT=M
# Comma-separated OANDA instruments to expose
OANDA_INSTRUMENTS=XAU_USD
# Client-side request ceiling (OANDA allows more; stay polite)
OANDA_MAX_REQUESTS_PER_SECOND=20
# How often the live candle is polled while a chart is open (seconds)
LIVE_POLL_SECONDS=2

# --- Local settings ---
# SQLite database (relative paths are resolved from backend/)
DATABASE_PATH=data/market.db
# Worker processes for backtests
BACKTEST_WORKERS=2
# Origins allowed to call the API during development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
